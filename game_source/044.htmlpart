) center/cover no-repeat;color:white;font-family:Inter,system-ui,sans-serif}#afFront.playing{display:none}.afShade{position:absolute;inset:0;background:linear-gradient(90deg,#041326f2 0%,#071a2abd 35%,#07182a38 70%,#07182a63),linear-gradient(0deg,#03101eee,#03101e00 48%)}.afTop{position:absolute;z-index:2;left:clamp(18px,4vw,64px);right:clamp(18px,4vw,64px);top:max(20px,env(safe-area-inset-top));display:flex;align-items:center;gap:14px}.afWing{font-size:45px;color:#ffbd34;transform:rotate(-12deg);filter:drop-shadow(0 5px 3px #0008)}.afLogo{display:flex;flex-direction:column;line-height:.8;transform:skew(-7deg)}.afLogo span{font:1000 clamp(17px,2.3vw,29px)/1 Impact,sans-serif;letter-spacing:.34em;color:#d9efff;text-shadow:0 3px #10283c}.afLogo b{font:1000 clamp(43px,7vw,86px)/.82 Impact,sans-serif;letter-spacing:.025em;background:linear-gradient(#fff26b 0 28%,#ffac2f 55%,#ed5c25);-webkit-background-clip:text;color:transparent;-webkit-text-stroke:2px #4d2104;filter:drop-shadow(0 7px 0 #071a2a) drop-shadow(0 10px 10px #000)}.afLogo i{margin-top:9px;font:900 9px/1 system-ui;letter-spacing:.42em;color:#8fdcff}.afTop>button{margin-left:auto;background:#061a2cca;border:1px solid #fff4;color:#fff;border-radius:99px;padding:9px 13px;font-weight:900}.afPanel{position:absolute;z-index:3;inset:145px clamp(18px,4vw,64px) 22px;display:none}.afPanel.active{display:block}.afHome{top:auto;bottom:7%;height:auto;max-width:610px}.afKicker{font-size:clamp(11px,1.3vw,15px);font-weight:1000;letter-spacing:.18em;color:#98dcff}.afMainButtons{display:grid;gap:10px}.afMainButtons button{position:relative;text-align:left;border:1px solid #79ddff58;border-left:7px solid #ffbd34;background:linear-gradient(90deg,#0a263dec,#0a263da8);color:#fff;border-radius:8px;padding:14px 70px 14px 20px;font:1000 clamp(22px,3.4vw,40px)/1 Impact,system-ui;letter-spacing:.04em;box-shadow:0 10px 24px #0008;transition:.18s}.afMainButtons button:hover{transform:translateX(9px);background:#123b57f2;border-color:#86e8ff}.afMainButtons small{display:block;font:900 9px system-ui;letter-spacing:.16em;color:#70d4ff;margin-bottom:5px}.afMainButtons em{position:absolute;right:22px;top:18px;font-size:42px;color:#ffca45}.afOnline{margin-top:13px;font-size:10px;font-weight:900;letter-spacing:.1em}.afOnline span{display:inline-block;width:8px;height:8px;border-radius:50%;background:#55e584;box-shadow:0 0 8px #55e584}.afPanelHead{height:72px;display:flex;align-items:center;gap:15px;background:#07192ddd;border:1px solid #7bcbea42;border-radius:15px;padding:10px 16px;max-width:1000px}.afPanelHead button{background:#ffffff10;border:1px solid #ffffff30;color:#fff;border-radius:9px;padding:10px;font-weight:900}.afPanelHead small{color:#63ceff;font-weight:900;letter-spacing:.18em}.afPanelHead h2{font:1000 clamp(25px,4vw,45px)/1 Impact;margin:2px 0;letter-spacing:.06em}.afGames{overflow:auto}#afGameMount{margin-top:10px;height:calc(100% - 82px);overflow:auto}.afGames .arcadeGrid{display:grid!important;grid-template-columns:repeat(3,minmax(210px,1fr))!important;gap:10px!important}.afGames .gameChoice{min-height:180px!important;background:linear-gradient(145deg,#0e3450ed,#071b2eed)!important;border:1px solid #72d9ff55!important;box-shadow:0 12px 25px #0008!important;transform:none!important}.afGames .gameChoice:hover{border-color:#ffcf4f!important;transform:translateY(-3px)!important}.afGames .gameChoice h2{font-family:Impact,system-ui;letter-spacing:.04em}.afGames .desktopHint{display:none}.partySetup{width:min(900px,100%);max-height:calc(100% - 82px);overflow:auto;margin-top:10px;background:#07192ddd;border:1px solid #65d8ff4f;border-radius:18px;padding:18px}.setupBlock h3{font:1000 14px system-ui;letter-spacing:.14em;color:#8edcff}.choiceRow{display:flex;gap:8px}.partyChoice,.roundChoice{flex:1;border:2px solid #ffffff1d;background:#0e2d43;color:#fff;border-radius:13px;padding:12px;font-weight:900}.partyChoice b{font:1000 30px Impact;display:block;color:#ffce4b}.partyChoice span{font-size:10px}.partyChoice.selected,.roundChoice.selected{border-color:#ffcc45;background:#173c55;box-shadow:inset 0 0 20px #ffcc4514}.crewPreview{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:16px 0}.crewCard{border-top:4px solid var(--c);background:#ffffff0c;border-radius:10px;padding:12px;display:grid;text-align:center}.crewCard span{font-size:27px}.crewCard small{font-size:8px;color:#9adcf7}.beginParty,#launchMatch,.matchCard button,#confirmResult{width:100%;border:0;border-radius:13px;padding:15px;background:linear-gradient(#ffe369,#ffad2e);color:#10283a;font-weight:1000;font-size:16px;box-shadow:0 5px 0 #a45d14}.standings{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}.standing{display:flex;align-items:center;gap:8px;background:#07192ddd;border-top:4px solid var(--c);border-radius:10px;padding:10px}.standing em{font:1000 24px Impact;color:#ffcd45}.standing span{display:grid}.standing small{font-size:8px;color:#8bd6f5}.standing strong{margin-left:auto}.matchCard{width:min(680px,100%);background:#07192dea;border:1px solid #6dd7ff4e;border-radius:18px;padding:15px}.matchArt{display:flex;align-items:center;gap:18px}.matchArt>span,.trophy{font-size:68px}.matchArt h3,.matchCard h3{font:1000 32px Impact;margin:3px 0}.matchArt small{color:#65d6ff;font-weight:900;letter-spacing:.14em}.matchArt p{margin:2px 0 12px}.schedule{display:flex;gap:6px;margin-top:9px}.scheduleGame{flex:1;display:grid;justify-items:center;background:#07192ddd;border:1px solid #ffffff20;border-radius:9px;padding:6px;opacity:.55}.scheduleGame.now{opacity:1;border-color:#ffcc42}.scheduleGame.done{opacity:.8;background:#17513c}.scheduleGame span{font-size:22px}.scheduleGame small{font-size:8px;text-align:center}.resultsCard{width:min(650px,94vw);background:#071a2bf2;border:2px solid #72dafa;border-radius:22px;padding:20px;margin:auto}.resultsCard>small{color:#73d9ff;font-weight:1000;letter-spacing:.2em}.resultsCard h2{font:1000 36px Impact;margin:5px 0}.resultChoice{width:100%;display:grid;grid-template-columns:auto 1fr auto;align-items:center;text-align:left;gap:10px;margin:7px 0;padding:10px;border:2px solid #ffffff20;border-left:6px solid var(--c);border-radius:10px;background:#102d43;color:#fff}.resultChoice span{font-size:25px}.resultChoice small{font-size:8px}.resultChoice.selected{border-color:#ffce45;background:#19445e}#confirmResult:disabled{filter:grayscale(1);opacity:.4}#cpuRail{position:fixed;z-index:84;right:8px;top:110px;width:170px;display:none;gap:7px}#cpuRail.show{display:grid}.cpuScreen{background:#071a2ef2;border:2px solid var(--c);border-radius:12px;overflow:hidden;box-shadow:0 10px 25px #0009}.cpuScreen header,.cpuScreen footer{padding:5px 7px;font-size:8px;font-weight:1000}.cpuScreen header span{display:inline-block;width:6px;height:6px;background:#54ee7d;border-radius:50%;margin-right:4px}.cpuScreen header b{float:right;color:#56ed80}.cpuGame{height:75px;position:relative;display:grid;place-items:center;background:linear-gradient(#4aa9d1,#39474d);overflow:hidden}.cpuGame i{font-size:35px;animation:cpuPlay .8s infinite alternate}.cpuGame small{position:absolute;bottom:2px;font-size:7px}.cpuMotion{position:absolute;width:16px;height:8px;background:var(--c);border-radius:10px;animation:cpuMove 1.2s infinite linear}#endPartyMatch{background:#ef593f;color:white;border:0;border-radius:9px;padding:9px;font-weight:1000}@keyframes cpuPlay{to{transform:translateY(-8px) rotate(5deg)}}@keyframes cpuMove{from{left:-20px;top:15px}to{left:180px;top:55px}}
@media(max-width:720px){.afTop{top:10px}.afLogo b{font-size:44px}.afLogo span{font-size:14px}.afPanel{inset:100px 10px 10px}.afHome{bottom:5%;top:auto}.afGames .arcadeGrid{grid-template-columns:1fr!important}.crewPreview{grid-template-columns:repeat(2,1fr)}.standings{grid-template-columns:repeat(2,1fr)}.scheduleGame small{display:none}#cpuRail{top:auto;bottom:75px;right:5px;width:115px}.cpuGame{height:45px}.cpuScreen header{font-size:6px}.cpuScreen footer{font-size:7px}.afPanelHead{height:62px}.partySetup{max-height:calc(100% - 70px)}.afTop>button{font-size:9px}.afWing{display:none}}
`;document.head.append(style);
})();
</script>
<style>
html,body,canvas,button,iframe,.game{-webkit-user-select:none!important;user-select:none!important;-webkit-touch-callout:none!important}img{-webkit-user-drag:none!important;user-drag:none!important}.universalTools,.cabinHost>.cabinMenu,#soundToggle,#rampMain{display:none!important}#afPauseDot{position:fixed;z-index:2147483000;top:max(8px,env(safe-area-inset-top));right:max(8px,env(safe-area-inset-right));width:44px;height:44px;border:1px solid #ffffff70;border-radius:50%;background:#071b2dc9;color:#fff;font:1000 17px/1 system-ui;backdrop-filter:blur(7px);box-shadow:0 5px 16px #0008;touch-action:manipulation}#afPauseDot[hidden]{display:none!important}#afQuickMenu{position:fixed;z-index:2147483001;inset:0;display:grid;place-items:center;padding:18px;background:#04101ccc;backdrop-filter:blur(5px)}#afQuickMenu[hidden]{display:none}#afQuickMenu .quickCard{width:min(330px,92vw);padding:18px;border:1px solid #7adfff70;border-radius:22px;background:#0a2638;color:white;box-shadow:0 22px 65px #000;text-align:center}#afQuickMenu h2{margin:0 0 13px;color:#ffd34e;font:1000 26px Impact,system-ui;letter-spacing:.08em}#afQuickMenu button{display:block;width:100%;min-height:49px;margin:8px 0;border:1px solid #ffffff32;border-radius:13px;background:#123c55;color:white;font-weight:1000}#afQuickMenu .primary{background:#ffd34e;color:#102b3a}#afQuickMenu .danger{background:#7e2630}
</style>
<style>#afFront:after{content:'MOBILE FIXED v3';position:fixed;z-index:8;right:12px;bottom:max(10px,env(safe-area-inset-bottom));padding:5px 9px;border-radius:999px;background:#ffd34e;color:#102b3a;font:1000 9px system-ui;letter-spacing:.08em;pointer-events:none}.topButtons,#bagPause,#bagRestart,#bagMenu{display:none!important}@media(pointer:coarse),(max-width:900px){.pedals{flex-direction:column!important}.pad button{height:134px!important;min-width:76px!important}.pedals button{height:62px!important}.bagTouch [data-bag="left"],.bagTouch [data-bag="right"]{height:76px!important;min-width:66px!important}.bagTouch [data-bag="rotate"],.bagTouch [data-bag="fast"]{height:60px!important}}</style>
<button id="afPauseDot" aria-label="Pause and game menu" hidden>Ⅱ</button>
<section id="afQuickMenu" hidden><div class="quickCard"><h2>GAME PAUSED</h2><button class="primary" id="afResume">RESUME</button><button id="afRestart">RESTART</button><button id="afFullscreen">FULL SCREEN</button><button class="danger" id="afReturnMain">RETURN TO MAIN MENU</button></div></section>
<script>
(()=>{'use strict';document.title='Airport Frenzy Mobile Fixed v3';
const dot=document.querySelector('#afPauseDot'),menu=document.querySelector('#afQuickMenu');let pausedByMenu=false;
document.addEventListener('contextmenu',e=>e.preventDefault(),{capture:true});document.addEventListener('dragstart',e=>e.preventDefault(),{capture:true});
function activeFrames(){return [...document.querySelectorAll('iframe')].filter(f=>{const r=f.getBoundingClientRect();return !f.hidden&&r.width>0&&r.height>0})}
function cleanFrame(f){try{const d=f.contentDocument;if(!d||d.documentElement.dataset.afClean)return;d.documentElement.dataset.afClean='1';const s=d.createElement('style');s.textContent='html,body,canvas,button,img,*{-webkit-user-select:none!important;user-select:none!important;-webkit-touch-callout:none!important}img{-webkit-user-drag:none!important}#pause,#restart,#mainMenu,#mode,#select,#overMain,.buttons,.universalTools,button[onclick*="location.reload"]{display:none!important}@media(pointer:coarse),(max-width:900px){[data-key="left"],[data-key="right"]{min-height:126px!important;min-width:74px!important}#upBtn,#downBtn{min-height:70px!important}}';d.head.append(s);d.querySelectorAll('button').forEach(b=>{if(/^(pause|restart|mode select|main menu|return to terminal)$/i.test(b.textContent.trim()))b.style.setProperty('display','none','important')});d.addEventListener('contextmenu',e=>e.preventDefault(),{capture:true});d.addEventListener('dragstart',e=>e.preventDefault(),{capture:true})}catch(_e){}}
document.querySelectorAll('iframe').forEach(f=>f.addEventListener('load',()=>cleanFrame(f)));
function pressPause(){let hit=false;activeFrames().forEach(f=>{cleanFrame(f);try{const b=f.contentDocument.querySelector('#pause');if(b){b.click();hit=true}}catch(_e){}});if(!hit){const b=document.querySelector('#pause:not([hidden]),#bagPause');if(b)b.click()}pausedByMenu=true}
function resume(){if(pausedByMenu)pressPause();pausedByMenu=false;menu.hidden=true}
dot.onclick=()=>{pressPause();menu.hidden=false};document.querySelector('#afResume').onclick=resume;
document.querySelector('#afFullscreen').onclick=async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(_e){}};
document.querySelector('#afRestart').onclick=()=>{activeFrames().forEach(f=>{try{const d=f.contentDocument,b=d.querySelector('#restart,#again');if(b)b.click();else{const src=f.srcdoc;f.srcdoc='';f.srcdoc=src}}catch(_e){}});const native=document.querySelector('#restart,#restartBtn,#bagRestart');if(native)native.click();pausedByMenu=false;menu.hidden=true};
document.querySelector('#afReturnMain').onclick=()=>{pausedByMenu=false;menu.hidden=true;const host=['#docHost','#assistHost','#cabinHost'].map(s=>document.querySelector(s)).find(h=>h&&!h.hidden);if(host){const b=host.querySelector('.cabinMenu');if(b)b.click()}else if(document.querySelector('#airHost')&&!document.querySelector('#airHost').hidden){try{document.querySelector('#airFrame').contentDocument.querySelector('#mainMenu').click()}catch(_e){}}else if(document.querySelector('#bagGame')&&!document.querySelector('#bagGame').hidden)document.querySelector('#bagMenu')?.click();else document.querySelector('#rampMain')?.click();document.querySelector('#afFront')?.classList.remove('playing')};
setInterval(()=>{activeFrames().forEach(cleanFrame);const front=document.querySelector('#afFront'),playing=front?.classList.contains('playing')||document.querySelector('#intro')?.classList.contains('hide');dot.hidden=!playing},350);
})();
</script>
</body>
</html>