'+mapL[c.l]+' + '+mapR[c.r]+(c.circle?' + /':'')+(c.taps===2?' · SIGNAL ×2':' · SPACE')}
const wait=ms=>new Promise(r=>setTimeout(r,ms));
async function demo(){demoing=true;step.textContent='WATCH';message.textContent='Instructor sequence';submit.disabled=true;for(let i=0;i<sequence.length;i++){if(!running)return;while(paused)await wait(100);showCommand(sequence[i]);await wait(950);monitor.classList.remove('demoing','circle');setPose('l','down','trainer');setPose('r','down','trainer');await wait(260)}demoing=false;playerIndex=0;submit.disabled=false;step.textContent='YOUR TURN · 1/'+sequence.length;prompt.innerHTML='<strong>REPEAT THE SEQUENCE</strong><small>Move both wands, then press SIGNAL or Space.</small>';resetPose()}
async function nextRound(){roundEl.textContent='ROUND '+round;sequence.push(commands[Math.floor(Math.random()*commands.length)]);await wait(450);demo()}
function begin(){sequence=[];round=1;playerIndex=0;running=true;paused=false;$('#start').classList.add('hidden');$('#over').classList.add('hidden');$('#pause').textContent='PAUSE';nextRound()}
function matches(c){return zones.l===c.l&&zones.r===c.r&&(!c.circle||circleReady[c.circle])}
function submitSignal(){if(!running||paused||demoing)return;const c=sequence[playerIndex];if(c.taps===2){tapCount++;clearTimeout(tapTimer);tapTimer=setTimeout(()=>{if(tapCount<2)fail(c)},650);if(tapCount<2){message.textContent='ONE MORE — EMERGENCY / BRAKE ACTION';sfx('cue');return}clearTimeout(tapTimer)}if(matches(c)){sfx('good');message.textContent='CORRECT · '+c.name;game.classList.add('flash');setTimeout(()=>game.classList.remove('flash'),220);playerIndex++;tapCount=0;resetPose();if(playerIndex===sequence.length){round++;best=Math.max(best,sequence.length);localStorage.airMarshallBest=best;bestEl.textContent='BEST '+best;step.textContent='SEQUENCE CLEAR';setTimeout(nextRound,850)}else step.textContent='YOUR TURN · '+(playerIndex+1)+'/'+sequence.length}else fail(c)}
function fail(c){if(!running)return;running=false;sfx('bad');$('#overTitle').textContent='SEQUENCE LOST';$('#summary').innerHTML='You cleared <b>'+(round-1)+'</b> full rounds.<br>The expected signal was <b>'+c.name+'</b>.';$('#over').classList.remove('hidden')}
function zoneFrom(side,x,y){const p=person.getBoundingClientRect(),sx=p.left+(side==='l'?90:168),sy=p.top+104,dx=x-sx,dy=y-sy;if(dy<-48&&Math.abs(dx)<105)return'up';if(dy>46&&Math.abs(dx)<105)return'down';if(side==='l'&&dx<-42||side==='r'&&dx>42)return'out';if(side==='l'&&dx>25||side==='r'&&dx<-25)return'inner';return'front'}
function drag(side,e){const h=handles[side],path=[];h.onpointerdown=ev=>{ev.preventDefault();try{h.setPointerCapture(ev.pointerId)}catch(_e){}path.length=0;const move=v=>{path.push([v.clientX,v.clientY]);const p=person.getBoundingClientRect(),sx=p.left+(side==='l'?90:168),sy=p.top+104,deg=Math.atan2(v.clientY-sy,v.clientX-sx)*180/Math.PI;arms[side].style.transform='rotate('+deg+'deg)';h.style.left=(v.clientX-27)+'px';h.style.top=(v.clientY-27)+'px';const next=zoneFrom(side,v.clientX,v.clientY);if(zones[side]!==next){zones[side]=next;armFeedback(side)}};move(ev);h.onpointermove=move;h.onpointerup=h.onpointercancel=v=>{move(v);h.onpointermove=null;h.onpointerup=null;if(path.length>5){let turn=0;for(let i=2;i<path.length;i++){const a=Math.atan2(path[i-1][1]-sy,path[i-1][0]-sx),b=Math.atan2(path[i][1]-sy,path[i][0]-sx);let d=b-a;if(d>Math.PI)d-=Math.PI*2;if(d<-Math.PI)d+=Math.PI*2;turn+=d}if(Math.abs(turn)>4.3){circleReady[side]=true;message.textContent=(side==='l'?'LEFT':'RIGHT')+' CIRCLE READY';armFeedback(side)}}}}}
drag('l');drag('r');
function keyPose(k,on){if(!on)return false;const left={w:'up',s:'down',a:'out',d:'inner',q:'front'}[k.toLowerCase()],right={ArrowUp:'up',ArrowDown:'down',ArrowRight:'out',ArrowLeft:'inner',Enter:'front'}[k];if(left){setPose('l',left);return true}if(right){setPose('r',right);return true}if(k==='/'){circleReady.r=true;message.textContent='RIGHT CIRCLE READY';return true}if(k===' '){submitSignal();return true}return false}
addEventListener('keydown',e=>{if(keyPose(e.key,true))e.preventDefault()});$('#submit').onclick=submitSignal;$('#begin').onclick=begin;$('#again').onclick=begin;$('#select').onclick=()=>{$('#over').classList.add('hidden');$('#start').classList.remove('hidden')};$('#mode').onclick=()=>{running=false;$('#over').classList.add('hidden');$('#start').classList.remove('hidden')};$('#pause').onclick=e=>{if(!running)return;paused=!paused;e.currentTarget.textContent=paused?'RESUME':'PAUSE';message.textContent=paused?'RAMP PAUSED':'TRAINING RESUMED'};function main(){parent.postMessage({type:'air-main-menu'},'*')}$('#mainMenu').onclick=main;$('#overMain').onclick=main;addEventListener('resize',resetPose);resetPose();
})();<\/script><script src="/online_party.js"></script>
</body></html>`;

const card=document.createElement('article');card.className='gameChoice marshal';card.innerHTML='<h2>🦺 Air Marshalling</h2><p>Repeat authentic ramp-hand-signal sequences by puppeteering two glowing wands. Built for touch gestures and keyboard play.</p><div class="startModes"><button class="start" id="startMarshal">START TRAINING</button></div>';
grid.append(card);
const airHost=document.createElement('section');airHost.className='cabinHost';airHost.id='airHost';airHost.hidden=true;airHost.innerHTML='<iframe id="airFrame" title="Airport Frenzy Air Marshalling" allow="fullscreen"></iframe>';
document.body.append(airHost);
function launchAir(){intro.classList.add('hide');airHost.hidden=false;document.querySelector('#airFrame').srcdoc=AIR_MARSHALLING_HTML}
function closeAir(){document.querySelector('#airFrame').srcdoc='';airHost.hidden=true;intro.classList.remove('hide')}
document.querySelector('#startMarshal').onclick=launchAir;
addEventListener('message',e=>{if(e.data&&e.data.type==='air-main-menu')closeAir()});

const style=document.createElement('style');style.textContent=`
#soundToggle{position:fixed;z-index:120;right:10px;top:max(52px,calc(env(safe-area-inset-top) + 48px));border:1px solid #ffffff44;background:#071d2dde;color:#fff;border-radius:99px;padding:7px 10px;font:900 10px system-ui;letter-spacing:.06em}
.universalTools{position:absolute;z-index:55;top:max(8px,env(safe-area-inset-top));left:150px;display:flex;gap:6px}.universalTools button{border:1px solid #ffffff3b;background:#102b3de8;color:white;border-radius:10px;padding:9px;font-weight:900;font-size:11px}.marshal{background:linear-gradient(145deg,#234b5e,#0a2535)!important;border-color:#ff9d3e!important}.marshal h2{color:#ffb65e!important}#airHost{inset:0;padding:0;background:#061a25}#airHost iframe{width:100%;height:100%;border:0;display:block}
@media(max-width:600px){.universalTools{left:auto;right:8px;top:max(46px,calc(env(safe-area-inset-top) + 42px))}.universalTools button{padding:7px 6px;font-size:9px}#soundToggle{top:auto;bottom:max(8px,env(safe-area-inset-bottom))}}
`;document.head.append(style);
const optionStyle=document.createElement('style');optionStyle.textContent=`
#soundToggle{display:none!important}.afTop{align-items:flex-start}.afLogo b{font-size:clamp(64px,9.2vw,122px);line-height:.76}.afLogo span{font-size:clamp(20px,2.8vw,36px)}.afLogo i{font-size:10px}.afWing{font-size:58px}.afTop>button{margin-top:7px}.afPanel{top:185px}.afHome{top:auto}
#afOptions{position:fixed;z-index:180;inset:0;background:#020b15d9;backdrop-filter:blur(9px);display:grid;place-items:center;padding:16px;color:white;font-family:Inter,system-ui,sans-serif}#afOptions[hidden]{display:none}.optionsCard{width:min(94vw,540px);background:linear-gradient(145deg,#123a52,#071b2b);border:2px solid #6ddcff;border-radius:22px;padding:19px;box-shadow:0 30px 90px #000}.optionsHead{display:flex;align-items:center;border-bottom:1px solid #ffffff26;padding-bottom:13px;margin-bottom:9px}.optionsHead>div{flex:1}.optionsHead small{color:#69d7ff;font-weight:1000;letter-spacing:.18em}.optionsHead h2{margin:2px 0 0;font:1000 42px/1 Impact,sans-serif;letter-spacing:.06em}.optionsHead button{width:42px;height:42px;border:1px solid #ffffff38;border-radius:10px;background:#ffffff10;color:#fff;font-size:18px}.optionRow{display:flex;align-items:center;gap:12px;margin:9px 0;padding:13px;background:#ffffff0b;border:1px solid #ffffff17;border-radius:12px}.optionRow span{display:grid;flex:1}.optionRow b{font-size:13px}.optionRow small{margin-top:3px;color:#9ed4e8;font-size:10px}.optionRow>button{min-width:78px;border:2px solid #5edb94;background:#174c3b;color:#72f2aa;border-radius:99px;padding:9px;font-weight:1000}.optionRow>button[aria-pressed="false"]{border-color:#ff7c68;background:#542b31;color:#ff9b8c}.optionRow.info{border-left:4px solid #ffca47}.optionsDone{width:100%;margin-top:8px;border:0;border-radius:12px;padding:14px;background:linear-gradient(#ffe16a,#ffad2e);color:#10283a;font-weight:1000;font-size:15px;box-shadow:0 5px 0 #9e5a14}
@media(max-width:720px){.afLogo b{font-size:58px}.afLogo span{font-size:17px}.afLogo i{font-size:7px}.afTop{left:12px;right:12px}.afTop>button{font-size:8px;padding:8px}.afWing{font-size:38px}.afPanel{inset:112px 10px 10px}}
`;document.head.append(optionStyle);
})();
</script>
<script>
/* Airport Frenzy front-end overhaul and Party Play tournament shell. */
(()=>{
'use strict';
const q=s=>document.querySelector(s),intro=q('#intro'),gameGrid=intro.querySelector('.arcadeGrid');
const gameCatalog=[
 {key:'cabin',icon:'🛫',name:'Flight Attendant',tag:'Cabin Rush',launch:'#startCabin',mode:'Take turns and compare service runs'},
 {key:'ramp',icon:'🚜',name:'Ramp Runner',tag:'Ground Ops',launch:'#startVersus',mode:'Head-to-head'},
 {key:'bags',icon:'🧳',name:'Bag Stacker',tag:'Load Control',launch:'#startBagVersus',mode:'Split-screen'},
 {key:'assist',icon:'♿',name:'Terminal Assist',tag:'Passenger Service',launch:'#startAssistVersus',mode:'Split-screen'},
 {key:'docs',icon:'🛂',name:'Document Control',tag:'Checkpoint',launch:'#startDocsPass',mode:'Pass & play'},
 {key:'marshal',icon:'🦺',name:'Air Marshalling',tag:'Ramp Signals',launch:'#startMarshal',mode:'Take turns and compare rounds'}
];
const front=document.createElement('section');front.id='afFront';front.innerHTML=`
 <div class="afShade"></div><div class="afTop"><div class="afWing">✈</div><div class="afLogo"><span>AIRPORT</span><b>FRENZY</b><i>GROUND CREW ARCADE</i></div><button id="afMusic">♪ AUDIO</button></div>
 <div class="afHome afPanel active" id="afHome"><p class="afKicker">CLOCK IN. GEAR UP. OWN THE TERMINAL.</p><div class="afMainButtons"><button id="partyPlay"><small>TOURNAMENT MODE</small>PARTY PLAY <em>›</em></button><button id="gameSelect"><small>CHOOSE YOUR SHIFT</small>GAME SELECT <em>›</em></button></div><div class="afOnline"><span></span> 6 AIRPORT CHALLENGES · OFFLINE READY</div></div>
 <div class="afPanel afGames" id="afGames"><div class="afPanelHead"><button class="afBack">‹ BACK</button><div><small>DEPARTURE BOARD</small><h2>SELECT A GAME</h2></div></div><div id="afGameMount"></div></div>
 <div class="afPanel" id="afParty"><div class="afPanelHead"><button class="afBack">‹ BACK</button><div><small>LOCAL TOURNAMENT</small><h2>PARTY PLAY</h2></div></div><div class="partySetup"><div class="setupBlock"><h3>CREW SIZE</h3><div class="choiceRow"><button class="partyChoice selected" data-crew="2"><b>2</b><span>HUMAN PLAYERS</span></button><button class="partyChoice" data-crew="4"><b>4</b><span>2 HUMANS + 2 CPU CREWS</span></button></div></div><div class="setupBlock"><h3>TOURNAMENT LENGTH</h3><div class="choiceRow rounds"><button class="roundChoice selected" data-rounds="2">2 GAMES</button><button class="roundChoice" data-rounds="4">4 GAMES</button><button class="roundChoice" data-rounds="6">FULL 6</button></div></div><div class="crewPreview" id="crewPreview"></div><button class="beginParty" id="beginParty">BUILD RANDOM TOURNAMENT</button></div></div>
 <div class="afPanel" id="afTournament"><div class="afPanelHead"><button id="quitParty">‹ QUIT</button><div><small id="tourLabel">PARTY PLAY</small><h2 id="matchTitle">TOURNAMENT</h2></div></div><div class="standings" id="standings"></div><div class="matchCard" id="matchCard"></div><div class="schedule" id="schedule"></div></div>
 <div class="afPanel" id="afResults"><div class="resultsCard"><small>MATCH COMPLETE</small><h2>WHO WON THIS SHIFT?</h2><p>Select the winner. CPU crews have simulated scores based on the same match length.</p><div id="resultChoices"></div><button id="confirmResult" disabled>CONFIRM RESULTS</button></div></div>`;
document.body.append(front);q('#afGameMount').append(gameGrid);
const options=document.createElement('section');options.id='afOptions';options.hidden=true;options.innerHTML=`<div class="optionsCard"><div class="optionsHead"><div><small>SYSTEM SETTINGS</small><h2>OPTIONS</h2></div><button id="closeOptions">✕</button></div><div class="optionRow"><span><b>BACKGROUND MUSIC</b><small>Soft airport lounge soundtrack</small></span><button id="optionMusic" aria-pressed="true">ON</button></div><div class="optionRow"><span><b>MENU SOUNDS</b><small>Buttons and interface feedback</small></span><button id="optionSfx" aria-pressed="true">ON</button></div><div class="optionRow info"><span><b>CONTROLS</b><small>Each game displays its keyboard and mobile controls before play.</small></span></div><button class="optionsDone" id="optionsDone">SAVE &amp; CLOSE</button></div>`;document.body.append(options);

let party={active:false,crew:2,total:2,index:0,games:[],players:[],awaiting:false,selected:null,cpuTimer:null,cpuScores:{}};
const panels=[q('#afHome'),q('#afGames'),q('#afParty'),q('#afTournament'),q('#afResults')];
function panel(id){panels.forEach(x=>x.classList.toggle('active',x.id===id))}
q('#partyPlay').onclick=()=>{renderCrew();panel('afParty')};q('#gameSelect').onclick=()=>panel('afGames');front.querySelectorAll('.afBack').forEach(b=>b.onclick=()=>panel('afHome'));
q('#afMusic').innerHTML='⚙ OPTIONS';
q('#afMusic').onclick=()=>{options.hidden=false};
function closeOptions(){options.hidden=true}
q('#closeOptions').onclick=closeOptions;q('#optionsDone').onclick=closeOptions;
q('#optionMusic').onclick=e=>{q('#soundToggle')?.click();const on=!q('#soundToggle')?.textContent.includes('MUTED');e.currentTarget.textContent=on?'ON':'OFF';e.currentTarget.setAttribute('aria-pressed',on)};
q('#optionSfx').onclick=e=>{window.__afUiSfxMuted=!window.__afUiSfxMuted;const on=!window.__afUiSfxMuted;e.currentTarget.textContent=on?'ON':'OFF';e.currentTarget.setAttribute('aria-pressed',on)};
front.addEventListener('click',e=>{if(e.target.closest('.start'))front.classList.add('playing')});
function renderCrew(){const n=party.crew,arr=n===2?[['P1','HUMAN','#4cd3ff'],['P2','HUMAN','#ffcf4a']]:[['P1','HUMAN','#4cd3ff'],['P2','HUMAN','#ffcf4a'],['CPU ALPHA','COMPUTER','#ff6b72'],['CPU BRAVO','COMPUTER','#8d79ff']];q('#crewPreview').innerHTML=arr.map((p,i)=>`<div class="crewCard" style="--c:${p[2]}"><span>${i<2?'🎮':'🤖'}</span><b>${p[0]}</b><small>${p[1]}</small></div>`).join('')}
front.querySelectorAll('.partyChoice').forEach(b=>b.onclick=()=>{front.querySelectorAll('.partyChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');party.crew=+b.dataset.crew;renderCrew()});
front.querySelectorAll('.roundChoice').forEach(b=>b.onclick=()=>{front.querySelectorAll('.roundChoice').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');party.total=+b.dataset.rounds});
function shuffled(){return [...gameCatalog].sort(()=>Math.random()-.5).slice(0,party.total)}
function buildPlayers(){return party.crew===2?[{name:'P1',type:'human',c:'#4cd3ff',pts:0,wins:0},{name:'P2',type:'human',c:'#ffcf4a',pts:0,wins:0}]:[{name:'P1',type:'human',c:'#4cd3ff',pts:0,wins:0},{name:'P2',type:'human',c:'#ffcf4a',pts:0,wins:0},{name:'CPU ALPHA',type:'cpu',c:'#ff6b72',pts:0,wins:0},{name:'CPU BRAVO',type:'cpu',c:'#8d79ff',pts:0,wins:0}]}
q('#beginParty').onclick=()=>{party.active=true;party.index=0;party.games=shuffled();party.players=buildPlayers();party.awaiting=false;renderTournament();panel('afTournament')};
function renderTournament(){const over=party.index>=party.games.length,cur=party.games[party.index];q('#tourLabel').textContent=over?'FINAL STANDINGS':`MATCH ${party.index+1} OF ${party.games.length}`;q('#matchTitle').textContent=over?'TOURNAMENT COMPLETE':cur.name.toUpperCase();q('#standings').innerHTML=[...party.players].sort((a,b)=>b.pts-a.pts).map((p,i)=>`<div class="standing" style="--c:${p.c}"><em>${i+1}</em><span><b>${p.name}</b><small>${p.type==='cpu'?'CPU CREW':'PLAYER'}</small></span><strong>${p.pts}<small> PTS</small></strong></div>`).join('');q('#schedule').innerHTML=party.games.map((g,i)=>`<div class="scheduleGame ${i<party.index?'done':i===party.index?'now':''}"><span>${g.icon}</span><b>${i+1}</b><small>${g.name}</small></div>`).join('');q('#matchCard').innerHTML=over?`<div class="trophy">🏆</div><h3>${[...party.players].sort((a,b)=>b.pts-a.pts)[0].name} WINS THE AIRPORT CUP!</h3><button onclick="document.querySelector('#quitParty').click()">RETURN TO MAIN MENU</button>`:`<div class="matchArt"><span>${cur.icon}</span><div><small>${cur.tag}</small><h3>${cur.name}</h3><p>${cur.mode}</p></div></div><button id="launchMatch">START MATCH <em>›</em></button>`;if(!over)q('#launchMatch').onclick=launchMatch}
function launchMatch(){const g=party.games[party.index],btn=q(g.launch);if(!btn)return;party.awaiting=true;party.cpuScores={};front.classList.add('playing');startCpuRail(g);btn.click()}
const cpuRail=document.createElement('aside');cpuRail.id='cpuRail';document.body.append(cpuRail);
function startCpuRail(g){clearInterval(party.cpuTimer);if(party.crew<4){cpuRail.classList.remove('show');return}cpuRail.innerHTML=party.players.filter(p=>p.type==='cpu').map((p,i)=>`<div class="cpuScreen" style="--c:${p.c}"><header><span></span>${p.name}<b>LIVE</b></header><div class="cpuGame"><i>${g.icon}</i><div class="cpuMotion m${i}"></div><small>${g.name}</small></div><footer>SCORE <strong id="cpuScore${i}">0</strong></footer></div>`).join('')+`<button id="endPartyMatch">END MATCH / RESULTS</button>`;cpuRail.classList.add('show');let ticks=0;party.cpuTimer=setInterval(()=>{ticks++;party.players.filter(p=>p.type==='cpu').forEach((p,i)=>{party.cpuScores[p.name]=(party.cpuScores[p.name]||0)+Math.floor(35+Math.random()*95);const e=q('#cpuScore'+i);if(e)e.textContent=party.cpuScores[p.name]});if(ticks>180)clearInterval(party.cpuTimer)},500);q('#endPartyMatch').onclick=returnFromMatch}
function returnFromMatch(){clearInterval(party.cpuTimer);cpuRail.classList.remove('show');const host=['#docHost','#assistHost','#cabinHost'].map(q).find(h=>h&&!h.hidden);if(host)host.querySelector('.cabinMenu')?.click();else if(q('#airHost')&&!q('#airHost').hidden){try{q('#airFrame').contentDocument.querySelector('#mainMenu').click()}catch(_e){}}else if(q('#bagGame')&&!q('#bagGame').hidden)q('#bagMenu')?.click();else q('#rampMain')?.click();setTimeout(showResults,100)}
function showResults(){if(!party.active||!party.awaiting)return;party.awaiting=false;front.classList.remove('playing');party.selected=null;q('#confirmResult').disabled=true;const ranked=[...party.players].sort((a,b)=>{if(a.type!==b.type)return a.type==='cpu'?(Math.random()>.52?-1:1):(Math.random()>.52?-1:1);return Math.random()-.5});q('#resultChoices').innerHTML=ranked.map((p,i)=>`<button class="resultChoice" data-name="${p.name}" style="--c:${p.c}"><span>${p.type==='cpu'?'🤖':'🎮'}</span><b>${p.name}</b><small>${p.type==='cpu'?'SIMULATED '+(party.cpuScores[p.name]||Math.floor(800+Math.random()*2200)):'TAP IF THIS PLAYER WON'}</small></button>`).join('');q('#resultChoices').querySelectorAll('button').forEach(b=>b.onclick=()=>{q('#resultChoices').querySelectorAll('button').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');party.selected=b.dataset.name;q('#confirmResult').disabled=false});panel('afResults')}
q('#confirmResult').onclick=()=>{const winner=party.players.find(p=>p.name===party.selected);winner.pts+=4;winner.wins++;party.players.filter(p=>p!==winner).sort(()=>Math.random()-.5).forEach((p,i)=>p.pts+=Math.max(0,2-i));party.index++;renderTournament();panel('afTournament')};
q('#quitParty').onclick=()=>{party.active=false;party.awaiting=false;clearInterval(party.cpuTimer);cpuRail.classList.remove('show');panel('afHome')};
new MutationObserver(()=>{if(!intro.classList.contains('hide')&&party.active&&party.awaiting)setTimeout(showResults,80);else if(!intro.classList.contains('hide')&&!party.active)front.classList.remove('playing')}).observe(intro,{attributes:true,attributeFilter:['class']});
renderCrew();
const style=document.createElement('style');style.textContent=`
#intro>.card{display:none!important}#afFront{--glass:#071b2de8;position:fixed;z-index:90;inset:0;overflow:hidden;background:#07182a url(data:image/webp;base64,