';
let cabinMarkup='';
const host=document.querySelector('#cabinHost'),frame=document.querySelector('#cabinFrame'),intro=document.querySelector('#intro');
document.querySelector('#startCabin').addEventListener('click',()=>{if(!cabinMarkup){const raw=atob(CABIN_SERVICE_HTML),bytes=Uint8Array.from(raw,ch=>ch.charCodeAt(0));cabinMarkup=new TextDecoder().decode(bytes)}intro.classList.add('hide');host.hidden=false;frame.srcdoc=cabinMarkup});
document.querySelector('#cabinMenu').addEventListener('click',()=>{frame.srcdoc='';host.hidden=true;intro.classList.remove('hide')});
})();
</script>
