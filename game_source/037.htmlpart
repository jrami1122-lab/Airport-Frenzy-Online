const colors=['#e94f64','#52b7e8','#f5c24f','#8f72dc','#47c98b','#f07f3f','#d86ba5','#75b94d'];
const defs=[
 {id:'standard',name:'Standard Bag',w:3,h:2,shape:'rect',weight:26},{id:'large',name:'Large Suitcase',w:6,h:4,shape:'rect',weight:18},{id:'square',name:'Square Case',w:4,h:4,shape:'rect',weight:14},{id:'duffel',name:'Duffel Bag',w:5,h:2,shape:'capsule',weight:18},{id:'skis',name:'Ski Case',w:10,h:1,shape:'skis',weight:5},{id:'surf',name:'Surfboard',w:9,h:2,shape:'diamond',weight:5},{id:'guitar',name:'Guitar Case',w:7,h:3,shape:'guitar',weight:6},{id:'bike',name:'Folded Bike',w:6,h:6,shape:'bike',weight:5},{id:'handbag',name:'Handbag',w:2,h:2,shape:'handbag',weight:5},{id:'backpack',name:'Backpack',w:2,h:3,shape:'backpack',weight:8},{id:'kids',name:'Kid Luggage',w:2,h:2,shape:'kids',weight:6},{id:'wheelchair',name:'Wheelchair',w:6,h:6,shape:'wheelchair',weight:3},{id:'stroller',name:'Stroller',w:6,h:5,shape:'stroller',weight:4}
];
function resize(){dpr=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+'px';canvas.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0)}addEventListener('resize',resize);resize();
const rnd=(a,b)=>a+Math.random()*(b-a),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function tone(f=440,d=.08,type='square',vol=.035){if(!audio)return;const o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.value=f;g.gain.setValueAtTime(vol,audio.currentTime);g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+d);o.connect(g).connect(audio.destination);o.start();o.stop(audio.currentTime+d)}
function weighted(){let total=defs.reduce((n,d)=>n+d.weight,0),r=Math.random()*total;for(const d of defs){r-=d.weight;if(r<=0)return{...d,color:colors[Math.floor(Math.random()*colors.length)]}}return{...defs[0],color:colors[0]}}
function rotated(d,r){return r%2?{w:d.h,h:d.w}:{w:d.w,h:d.h}}
const PHYS=24,PHYS_STEP=1/PHYS,BELT_GAP=.31,ALPHA_BODY=190;
const bodyCache=new Map();let nextPieceId=1;
function bodyKey(item,r){return[item.id,item.shape,item.w,item.h,r%2,rasterBagIndex(item)].join('|')}
function bodyAsset(item,r){
 const key=bodyKey(item,r);if(bodyCache.has(key))return bodyCache.get(key);
 const ow=Math.max(1,Math.round(item.w*PHYS)),oh=Math.max(1,Math.round(item.h*PHYS)),base=document.createElement('canvas');base.width=ow;base.height=oh;const bg=base.getContext('2d',{willReadFrequently:true});
 bg.clearRect(0,0,ow,oh);drawItemOn(bg,item,0,0,ow,oh,0);const raw=bg.getImageData(0,0,ow,oh),clean=document.createElement('canvas');clean.width=ow;clean.height=oh;const cg=clean.getContext('2d',{willReadFrequently:true}),cd=cg.createImageData(ow,oh);
 for(let i=0;i<raw.data.length;i+=4)if(raw.data[i+3]>=ALPHA_BODY){cd.data[i]=raw.data[i];cd.data[i+1]=raw.data[i+1];cd.data[i+2]=raw.data[i+2];cd.data[i+3]=255}cg.putImageData(cd,0,0);
 let canvas=clean;if(r%2){canvas=document.createElement('canvas');canvas.width=oh;canvas.height=ow;const g=canvas.getContext('2d');g.translate(oh,0);g.rotate(Math.PI/2);g.drawImage(clean,0,0)}
 const g=canvas.getContext('2d',{willReadFrequently:true}),data=g.getImageData(0,0,canvas.width,canvas.height).data,cells=[],bottom=new Map(),top=new Map();let minX=canvas.width,minY=canvas.height,maxX=-1,maxY=-1;
 for(let y=0;y<canvas.height;y++)for(let x=0;x<canvas.width;x++)if(data[(y*canvas.width+x)*4+3]){cells.push([x,y]);if(!top.has(x))top.set(x,y);bottom.set(x,y);minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y)}
 const z=rotated(item,r),asset={canvas,z,w:canvas.width,h:canvas.height,cells,bottom,top,bounds:{minX,minY,maxX,maxY}};bodyCache.set(key,asset);return asset
}
function footprint(item,r){return bodyAsset(item,r)}
function waitForImage(img){if(img.complete&&img.naturalWidth)return Promise.resolve();return new Promise(resolve=>{img.addEventListener('load',resolve,{once:true});img.addEventListener('error',resolve,{once:true})})}
let assetsReadyFlag=false;const assetsReady=Promise.all([waitForImage(bagArt),...bagSprites.map(waitForImage)]).then(()=>{bodyCache.clear();assetsReadyFlag=true});
const M=Matter,{Engine,Bodies,Body,Composite,Sleeping,Vertices,Events}=M,WORLD_W=18*PHYS,WORLD_H=32*PHYS;
function makeBoundaries(){return[
 Bodies.rectangle(WORLD_W/2,WORLD_H+28,WORLD_W+96,56,{isStatic:true,label:'floor',friction:1,restitution:0}),
 Bodies.rectangle(-28,WORLD_H/2,56,WORLD_H+112,{isStatic:true,label:'leftWall',friction:1,restitution:0}),
 Bodies.rectangle(WORLD_W+28,WORLD_H/2,56,WORLD_H+112,{isStatic:true,label:'rightWall',friction:1,restitution:0})]}
function makeBoard(id){const engine=Engine.create({enableSleeping:false});engine.gravity.y=2.8;engine.gravity.scale=.001;const boundaries=makeBoundaries();Composite.add(engine.world,boundaries);const board={id,cols:18,rows:32,line:5,engine,boundaries,pieces:[],active:null,queue:[weighted(),weighted(),weighted(),weighted()],belt:0,fast:false,loaderX:7,rotation:0,score:0,count:0,bonusCount:0,bonusColor:null,bonusFlash:0,gameOver:false,flash:0};const land=e=>{const active=board.active;if(!active||active.plugin.bag.landing)return;for(const pair of e.pairs){if(pair.bodyA!==active&&pair.bodyB!==active)continue;const other=pair.bodyA===active?pair.bodyB:pair.bodyA;if(other.label==='floor'||other.plugin?.bag?.settled){beginStiffening(active);break}}};Events.on(engine,'collisionStart',land);Events.on(engine,'collisionActive',land);return board}
function reset(v=false){versus=v;boards=[makeBoard('P1')];if(v)boards.push(makeBoard('P2'));running=true;paused=false;document.querySelector('#bagPause').textContent='PAUSE';hud.innerHTML='<b>BAG STACKER · MATTER.JS PHYSICS</b> · '+(v?'P1 WASD · P2 ARROWS':'ARROWS / TOUCH')}
function boundaryPoints(asset){const occupied=new Set(asset.cells.map(([x,y])=>x+','+y)),pts=[];for(const [x,y]of asset.cells)if(!occupied.has((x-1)+','+y)||!occupied.has((x+1)+','+y)||!occupied.has(x+','+(y-1))||!occupied.has(x+','+(y+1)))pts.push({x:x-asset.w/2,y:y-asset.h/2});return pts}
function createBagBody(item,r,cx,topY){const asset=bodyAsset(item,r),points=boundaryPoints(asset),hull=Vertices.hull(points),centre=Vertices.centre(hull),opts={label:'bag:'+item.id,restitution:.015,friction:.78,frictionStatic:1.15,frictionAir:.018,density:((item.id==='large'||item.id==='bike')?0.0045:((item.id==='handbag'||item.id==='kids')?0.0022:0.0032))};let body;
 if(item.shape==='bike')body=Bodies.circle(cx,topY+asset.h/2,Math.min(asset.w,asset.h)*.46,opts);else body=Bodies.fromVertices(cx+centre.x,topY+asset.h/2+centre.y,[hull],opts,true);
 if(!body)body=Bodies.rectangle(cx,topY+asset.h/2,Math.max(4,asset.w*.92),Math.max(4,asset.h*.88),opts);
 body.frictionAir=.018;Body.setInertia(body,body.inertia*3.5);body.plugin.bag={item,r,asset,offset:item.shape==='bike'?{x:0,y:0}:centre,settled:false,landing:false,landingAge:0,lockedPosition:null,lockedAngle:null,spawnedAt:performance.now()};return body}
function moveLoader(b,dir){if(!running||paused||b.gameOver)return;const next=b.queue[0],z=rotated(next,b.rotation);b.loaderX=clamp(b.loaderX+dir,0,b.cols-z.w);tone(250+dir*30,.035,'square',.018)}
function rotateLoader(b){if(!running||paused||b.gameOver||b.belt>=.96)return;b.rotation=(b.rotation+1)%2;const z=rotated(b.queue[0],b.rotation);b.loaderX=clamp(b.loaderX,0,b.cols-z.w);tone(430,.05,'triangle',.025)}
function launch(b){if(b.active||b.gameOver)return;const next=b.queue.shift(),z=rotated(next,b.rotation),cx=(clamp(b.loaderX,0,b.cols-z.w)+z.w/2)*PHYS,body=createBagBody(next,b.rotation,cx,-z.h*PHYS*.55);Composite.add(b.engine.world,body);Sleeping.set(body,false);Body.setVelocity(body,{x:0,y:4.25});Body.setAngularVelocity(body,0);b.pieces.push(body);b.active=body;b.queue.push(weighted());b.rotation=0;b.belt=Math.max(0,b.belt-BELT_GAP);b.loaderX=clamp(b.loaderX,0,b.cols-b.queue[0].w);tone(170,.11,'sawtooth',.045)}
function touchingGroundedBody(b,body){const collisions=M.Query.collides(body,[...b.boundaries,...b.pieces.filter(q=>q!==body)]);return collisions.some(c=>{const other=c.bodyA===body?c.bodyB:c.bodyA;if(other.label==='floor')return true;if(!other.plugin?.bag?.settled)return false;return other.bounds.min.y>=body.position.y-2})}
function beginStiffening(body){const info=body.plugin.bag;if(info.landing||info.settled)return;info.landing=true;info.landingAge=0;body.restitution=0;body.friction=1;body.frictionStatic=2;body.frictionAir=.82}
function pointSegmentDistanceSq(p,a,z){const vx=z.x-a.x,vy=z.y-a.y,wx=p.x-a.x,wy=p.y-a.y,len=vx*vx+vy*vy;if(!len)return wx*wx+wy*wy;const t=clamp((wx*vx+wy*vy)/len,0,1),dx=p.x-(a.x+t*vx),dy=p.y-(a.y+t*vy);return dx*dx+dy*dy}
function bodiesTouch(a,z,tolerance=3){if(a.bounds.max.x+tolerance<z.bounds.min.x||z.bounds.max.x+tolerance<a.bounds.min.x||a.bounds.max.y+tolerance<z.bounds.min.y||z.bounds.max.y+tolerance<a.bounds.min.y)return false;if(M.Query.collides(a,[z]).length)return true;const limit=tolerance*tolerance,near=(one,two)=>one.vertices.some(p=>two.vertices.some((q,i)=>pointSegmentDistanceSq(p,q,two.vertices[(i+1)%two.vertices.length])<=limit));return near(a,z)||near(z,a)}
function findColorBridge(b){const settled=b.pieces.filter(p=>p.plugin?.bag?.settled),byColor=new Map();for(const p of settled){const color=p.plugin.bag.item.color;if(!byColor.has(color))byColor.set(color,[]);byColor.get(color).push(p)}for(const [color,list] of byColor){const queue=list.filter(p=>p.bounds.max.y>=WORLD_H-4),seen=new Set(queue);while(queue.length){const p=queue.shift();if(p.bounds.min.y<=b.line*PHYS+4)return color;for(const q of list)if(!seen.has(q)&&bodiesTouch(p,q)){seen.add(q);queue.push(q)}}}return null}
function awardColorBridge(b){if(b.bonusCount)return;const color=findColorBridge(b);if(!color)return;b.bonusCount=5;b.bonusColor=color;b.bonusFlash=3;b.flash=1;tone(740,.12,'square',.055);setTimeout(()=>tone(930,.16,'square',.05),110);setTimeout(()=>tone(1180,.22,'triangle',.05),230)}
function settleActive(b,dt){const body=b.active;if(!body)return;const info=body.plugin.bag,supported=touchingGroundedBody(b,body);if(supported&&!info.landing)beginStiffening(body);if(info.landing){info.landingAge+=dt;Body.setVelocity(body,{x:body.velocity.x*.12,y:body.velocity.y*.12});Body.setAngularVelocity(body,body.angularVelocity*.08)}else if(!supported&&Math.hypot(body.velocity.x,body.velocity.y)<.35){Sleeping.set(body,false);Body.setVelocity(body,{x:body.velocity.x,y:Math.max(body.velocity.y,1.5)})}if(info.landing&&info.landingAge>=.2){info.settled=true;info.lockedPosition={x:body.position.x,y:body.position.y};info.lockedAngle=body.angle;Body.setVelocity(body,{x:0,y:0});Body.setAngularVelocity(body,0);Body.setStatic(body,true);Body.setPosition(body,info.lockedPosition);Body.setAngle(body,info.lockedAngle);b.active=null;b.count++;awardColorBridge(b);b.score+=Math.round(info.asset.w*info.asset.h/5)+Math.max(0,Math.round((WORLD_H-body.bounds.min.y)*.34));b.flash=.22;tone(620,.08,'square',.035);window.__bagPhysicsReport=validateMatterBoard(b);if(body.bounds.min.y<b.line*PHYS){b.gameOver=true;checkEnd()}}}
function validateMatterBoard(b){const orphans=[],overlaps=[];for(const p of b.pieces){if(!p.plugin.bag.settled)continue;const hits=M.Query.collides(p,[...b.boundaries,...b.pieces.filter(q=>q!==p)]);if(!hits.length)orphans.push(p.id);for(const h of hits)if(h.depth>2.5)overlaps.push({id:p.id,depth:h.depth})}return{orphans,overlaps,passed:!orphans.length&&!overlaps.length}}
function update(dt){if(!assetsReadyFlag||!running||paused)return;for(const b of boards){b.flash=Math.max(0,b.flash-dt);b.bonusFlash=Math.max(0,b.bonusFlash-dt);if(!b.gameOver){const beltSpeed=Math.min(.21,.105+b.count*.0022)*(b.fast?2.15:1);if(!b.active)b.belt+=dt*beltSpeed;else b.belt=Math.min(.94,b.belt+dt*beltSpeed*.65);if(b.belt>=1&&!b.active)launch(b)}Engine.update(b.engine,Math.min(33.333,dt*1000));for(const p of b.pieces)if(p.plugin?.bag?.settled){const lock=p.plugin.bag;if(!p.isStatic)Body.setStatic(p,true);Body.setVelocity(p,{x:0,y:0});Body.setAngularVelocity(p,0);Body.setPosition(p,lock.lockedPosition);Body.setAngle(p,lock.lockedAngle)}settleActive(b,dt);if(b.pieces.some(p=>p.position.y>WORLD_H+120)){b.gameOver=true;checkEnd()}}}
function checkEnd(){for(const b of boards)window.__bagPhysicsReport={...validateMatterBoard(b),bagCount:b.count,bonusCount:b.bonusCount,totalCount:b.count+b.bonusCount,bonusColor:b.bonusColor};if(!versus){paused=true;const a=boards[0];hud.innerHTML='<b>HOLD FULL</b> · '+a.count+' bags'+(a.bonusCount?' + 5 color bonus':'')+' = '+(a.count+a.bonusCount)+' total · '+a.score+' points'}else if(boards.every(b=>b.gameOver)){paused=true;const a=boards[0],z=boards[1],at=a.count+a.bonusCount,zt=z.count+z.bonusCount,winner=at===zt?(a.score===z.score?'DRAW':a.score>z.score?'P1 WINS':'P2 WINS'):at>zt?'P1 WINS':'P2 WINS';hud.innerHTML='<b>'+winner+'</b> · P1 '+at+' total'+(a.bonusCount?' (+5)':'')+' · P2 '+zt+' total'+(z.bonusCount?' (+5)':'')}}
function tubePath(x,y,w,h){ctx.beginPath();ctx.roundRect(x,y,w,h,Math.min(w*.18,70));ctx.fill();ctx.stroke();ctx.save();ctx.globalAlpha=.18;ctx.strokeStyle='#fff';ctx.lineWidth=5;for(let yy=y+30;yy<y+h;yy+=58){ctx.beginPath();ctx.moveTo(x+10,yy);ctx.lineTo(x+w-10,yy);ctx.stroke()}ctx.restore()}
function drawItemOld(item,x,y,w,h,angle=0){ctx.save();ctx.translate(x+w/2,y+h/2);ctx.rotate(angle);ctx.translate(-w/2,-h/2);ctx.fillStyle=item.color;ctx.strokeStyle='#18252d';ctx.lineWidth=Math.max(2,Math.min(w,h)*.08);const r=Math.min(w,h)*.22;if(item.shape==='capsule'){ctx.beginPath();ctx.roundRect(1,h*.12,w-2,h*.76,h*.38);ctx.fill();ctx.stroke();ctx.strokeStyle='#fff9';ctx.beginPath();ctx.moveTo(w*.28,h*.2);ctx.quadraticCurveTo(w*.5,-h*.2,w*.72,h*.2);ctx.stroke()}else if(item.shape==='diamond'){ctx.beginPath();ctx.moveTo(w*.08,h/2);ctx.quadraticCurveTo(w*.5,-h*.08,w*.92,h/2);ctx.quadraticCurveTo(w*.5,h*1.08,w*.08,h/2);ctx.fill();ctx.stroke();ctx.strokeStyle='#fff8';ctx.beginPath();ctx.moveTo(w*.25,h/2);ctx.lineTo(w*.75,h/2);ctx.stroke()}else if(item.shape==='skis'){ctx.fillRect(0,h*.17,w,h*.25);ctx.strokeRect(0,h*.17,w,h*.25);ctx.fillStyle='#f8f8f8';ctx.fillRect(0,h*.6,w,h*.22);ctx.strokeRect(0,h*.6,w,h*.22);ctx.fillStyle='#222';ctx.fillRect(w*.42,h*.1,w*.05,h*.8);ctx.fillRect(w*.56,h*.1,w*.05,h*.8)}else if(item.shape==='guitar'){ctx.beginPath();ctx.moveTo(0,h*.37);ctx.quadraticCurveTo(w*.15,0,w*.35,h*.2);ctx.lineTo(w*.92,h*.34);ctx.lineTo(w,h*.66);ctx.lineTo(w*.35,h*.8);ctx.quadraticCurveTo(w*.15,h,w,h*.63);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#492d1d';ctx.beginPath();ctx.arc(w*.24,h*.5,h*.15,0,7);ctx.fill()}else if(item.shape==='bike'){ctx.globalAlpha=.25;ctx.fillRect(0,0,w,h);ctx.globalAlpha=1;ctx.strokeStyle='#18252d';ctx.lineWidth=Math.max(3,w*.07);ctx.beginPath();ctx.arc(w*.28,h*.62,w*.22,0,7);ctx.arc(w*.72,h*.62,w*.22,0,7);ctx.moveTo(w*.28,h*.62);ctx.lineTo(w*.5,h*.27);ctx.lineTo(w*.72,h*.62);ctx.lineTo(w*.28,h*.62);ctx.stroke()}else if(item.shape==='wheelchair'){ctx.globalAlpha=.3;ctx.fillRect(0,0,w,h);ctx.globalAlpha=1;ctx.strokeStyle='#17252b';ctx.lineWidth=Math.max(3,w*.07);ctx.beginPath();ctx.arc(w*.42,h*.62,w*.3,0,7);ctx.stroke();ctx.fillStyle=item.color;ctx.fillRect(w*.38,h*.15,w*.35,h*.42);ctx.strokeRect(w*.38,h*.15,w*.35,h*.42);ctx.beginPath();ctx.moveTo(w*.65,h*.5);ctx.lineTo(w*.9,h*.82);ctx.stroke()}else if(item.shape==='stroller'){ctx.globalAlpha=.3;ctx.fillRect(0,0,w,h);ctx.globalAlpha=1;ctx.fillStyle=item.color;ctx.beginPath();ctx.arc(w*.42,h*.38,w*.3,Math.PI,0);ctx.lineTo(w*.73,h*.55);ctx.lineTo(w*.2,h*.55);ctx.closePath();ctx.fill();ctx.stroke();ctx.beginPath();ctx.arc(w*.28,h*.75,w*.12,0,7);ctx.arc(w*.72,h*.75,w*.12,0,7);ctx.moveTo(w*.65,h*.3);ctx.lineTo(w*.88,h*.12);ctx.stroke()}else{ctx.beginPath();ctx.roundRect(1,1,w-2,h-2,r);ctx.fill();ctx.stroke();if(item.shape==='handbag'){ctx.beginPath();ctx.arc(w*.5,h*.2,w*.25,Math.PI,0);ctx.stroke()}else if(item.shape==='backpack'){ctx.fillStyle='#ffffff40';ctx.beginPath();ctx.roundRect(w*.15,h*.52,w*.7,h*.3,r*.5);ctx.fill();ctx.stroke()}else if(item.shape==='kids'){ctx.fillStyle='#fff9';ctx.beginPath();ctx.arc(w*.5,h*.48,Math.min(w,h)*.18,0,7);ctx.fill();ctx.fillStyle='#222';ctx.fillRect(w*.46,-h*.18,w*.08,h*.22)}else{ctx.fillStyle='#ffffff45';ctx.fillRect(w*.12,h*.18,w*.76,h*.12);ctx.strokeStyle='#222';ctx.beginPath();ctx.moveTo(w*.35,0);ctx.quadraticCurveTo(w*.5,-h*.18,w*.65,0);ctx.stroke();ctx.fillStyle='#18252d';ctx.beginPath();ctx.arc(w*.18,h*.96,Math.min(w,h)*.07,0,7);ctx.arc(w*.82,h*.96,Math.min(w,h)*.07,0,7);ctx.fill()}}ctx.restore()}
function rasterBagIndex(item){if(item.shape==='capsule'||item.id==='backpack')return 2;const n=Math.max(0,colors.indexOf(item.color));return[3,5,1,0,2,1,3,2][n%8]}
const bagCropBounds=[[150,163,455,471],[93,146,353,483],[158,68,448,436],[88,83,358,438],[171,16,431,385],[80,9,368,386]];
function drawItemOn(g,item,x,y,w,h,angle=0){if(bagArt.complete&&bagArt.naturalWidth&&['rect','capsule','handbag','backpack','kids'].includes(item.shape)){const quarter=Math.abs(Math.sin(angle))>.7,dw=quarter?h:w,dh=quarter?w:h,i=rasterBagIndex(item),sprite=bagSprites[i];g.save();g.translate(x+w/2,y+h/2);g.rotate(angle);g.shadowColor='#0008';g.shadowBlur=Math.max(4,Math.min(dw,dh)*.12);g.shadowOffsetY=Math.max(2,dh*.05);g.drawImage(sprite,-dw/2,-dh/2,dw,dh);g.restore();return}g.save();g.translate(x+w/2,y+h/2);g.rotate(angle);const quarter=Math.abs(Math.sin(angle))>.7,dw=quarter?h:w,dh=quarter?w:h;g.translate(-dw/2,-dh/2);g.shadowColor='#0009';g.shadowBlur=Math.max(4,Math.min(dw,dh)*.18);g.shadowOffsetX=Math.max(2,dw*.035);g.shadowOffsetY=Math.max(3,dh*.07);const edge=Math.max(2,Math.min(dw,dh)*.065),rad=Math.min(dw,dh)*.22,base=g.createLinearGradient(0,0,dw,dh);base.addColorStop(0,'#ffffff');base.addColorStop(.08,item.color);base.addColorStop(.68,item.color);base.addColorStop(1,'#172229');g.strokeStyle='#142129';g.lineWidth=edge;
 const paddedCase=()=>{g.fillStyle=base;g.beginPath();g.roundRect(edge,edge,dw-edge*2,dh-edge*2,rad);g.fill();g.stroke();g.shadowColor='transparent';g.strokeStyle='#ffffff70';g.lineWidth=Math.max(1,edge*.45);g.beginPath();g.roundRect(edge*2,edge*2,dw-edge*4,dh-edge*4,rad*.72);g.stroke();g.strokeStyle='#111b';g.setLineDash([Math.max(3,edge),Math.max(2,edge*.65)]);g.beginPath();g.moveTo(dw*.12,dh*.2);g.lineTo(dw*.88,dh*.2);g.stroke();g.setLineDash([])};
 if(item.shape==='wheelchair'){g.shadowColor='transparent';g.strokeStyle='#dbe5e8';g.lineWidth=Math.max(3,dw*.055);g.beginPath();g.arc(dw*.4,dh*.64,dw*.28,0,7);g.stroke();g.fillStyle=base;g.beginPath();g.roundRect(dw*.37,dh*.1,dw*.39,dh*.47,rad*.35);g.fill();g.stroke();g.strokeStyle='#18242a';g.beginPath();g.moveTo(dw*.68,dh*.48);g.lineTo(dw*.9,dh*.82);g.lineTo(dw*.7,dh*.82);g.stroke();g.fillStyle='#111';g.beginPath();g.arc(dw*.78,dh*.81,dw*.09,0,7);g.fill()}else if(item.shape==='stroller'){g.shadowColor='transparent';g.fillStyle=base;g.beginPath();g.arc(dw*.43,dh*.38,dw*.3,Math.PI,0);g.lineTo(dw*.75,dh*.58);g.lineTo(dw*.18,dh*.58);g.closePath();g.fill();g.stroke();g.strokeStyle='#dbe5e8';g.lineWidth=Math.max(3,dw*.05);g.beginPath();g.moveTo(dw*.63,dh*.27);g.lineTo(dw*.9,dh*.08);g.moveTo(dw*.28,dh*.58);g.lineTo(dw*.2,dh*.82);g.moveTo(dw*.68,dh*.58);g.lineTo(dw*.78,dh*.82);g.stroke();g.fillStyle='#111';for(const xx of [dw*.2,dw*.78]){g.beginPath();g.arc(xx,dh*.84,dw*.1,0,7);g.fill()}}else if(item.shape==='capsule'){g.fillStyle=base;g.beginPath();g.roundRect(edge,dh*.1,dw-edge*2,dh*.8,dh*.4);g.fill();g.stroke();g.shadowColor='transparent';g.strokeStyle='#fff8';g.beginPath();g.moveTo(dw*.26,dh*.23);g.quadraticCurveTo(dw*.5,-dh*.08,dw*.74,dh*.23);g.stroke();g.strokeStyle='#172229';g.beginPath();g.moveTo(dw*.18,dh*.5);g.lineTo(dw*.82,dh*.5);g.stroke()}else if(item.shape==='skis'){paddedCase();g.fillStyle='#fff4';g.beginPath();g.roundRect(dw*.04,dh*.24,dw*.92,dh*.26,dh*.13);g.fill();g.fillStyle='#172229';g.font='900 '+Math.max(7,dh*.25)+'px Arial';g.textAlign='center';g.fillText('SKI BAG',dw*.5,dh*.72)}else if(item.shape==='diamond'){g.fillStyle=base;g.beginPath();g.moveTo(dw*.03,dh*.5);g.quadraticCurveTo(dw*.5,-dh*.03,dw*.97,dh*.5);g.quadraticCurveTo(dw*.5,dh*1.03,dw*.03,dh*.5);g.fill();g.stroke();g.shadowColor='transparent';g.strokeStyle='#fff8';g.beginPath();g.moveTo(dw*.18,dh*.5);g.lineTo(dw*.82,dh*.5);g.stroke();g.fillStyle='#172229';g.font='900 '+Math.max(7,dh*.22)+'px Arial';g.textAlign='center';g.fillText('SURF CASE',dw*.5,dh*.58)}else if(item.shape==='guitar'){g.fillStyle=base;g.beginPath();g.moveTo(edge,dh*.35);g.quadraticCurveTo(dw*.16,0,dw*.37,dh*.2);g.lineTo(dw*.92,dh*.32);g.lineTo(dw-edge,dh*.68);g.lineTo(dw*.37,dh*.8);g.quadraticCurveTo(dw*.16,dh,edge,dh*.65);g.closePath();g.fill();g.stroke();g.shadowColor='transparent';g.strokeStyle='#fff7';g.beginPath();g.moveTo(dw*.28,dh*.32);g.lineTo(dw*.86,dh*.46);g.stroke();g.fillStyle='#172229';g.beginPath();g.arc(dw*.23,dh*.5,dh*.13,0,7);g.fill()}else if(item.shape==='bike'){g.fillStyle=base;g.beginPath();g.arc(dw*.5,dh*.5,Math.min(dw,dh)*.46,0,7);g.fill();g.stroke();g.shadowColor='transparent';g.strokeStyle='#fff7';g.beginPath();g.arc(dw*.5,dh*.5,Math.min(dw,dh)*.34,0,7);g.stroke();g.fillStyle='#172229';g.font='900 '+Math.max(8,dh*.13)+'px Arial';g.textAlign='center';g.fillText('FOLDING BIKE',dw*.5,dh*.54)}else{paddedCase();g.shadowColor='transparent';if(item.shape==='handbag'){g.strokeStyle='#172229';g.lineWidth=edge;g.beginPath();g.arc(dw*.5,dh*.25,dw*.24,Math.PI,0);g.stroke()}else if(item.shape==='backpack'){g.fillStyle='#ffffff3d';g.beginPath();g.roundRect(dw*.14,dh*.54,dw*.72,dh*.28,rad*.5);g.fill();g.strokeStyle='#172229';g.beginPath();g.moveTo(dw*.12,dh*.26);g.quadraticCurveTo(dw*.5,-dh*.02,dw*.88,dh*.26);g.stroke()}else if(item.shape==='kids'){g.fillStyle='#fff8';g.beginPath();g.arc(dw*.5,dh*.5,Math.min(dw,dh)*.17,0,7);g.fill();g.fillStyle='#172229';g.beginPath();g.arc(dw*.45,dh*.47,2,0,7);g.arc(dw*.55,dh*.47,2,0,7);g.fill()}else{g.fillStyle='#ffffff35';g.fillRect(dw*.12,dh*.18,dw*.76,dh*.12);g.strokeStyle='#172229';g.beginPath();g.moveTo(dw*.35,edge);g.quadraticCurveTo(dw*.5,-dh*.14,dw*.65,edge);g.stroke();g.fillStyle='#10171b';for(const xx of [dw*.18,dw*.82]){g.beginPath();g.arc(xx,dh-edge,Math.min(dw,dh)*.06,0,7);g.fill()}}}g.restore()}
function drawItem(item,x,y,w,h,angle=0){const r=Math.abs(Math.sin(angle))>.7?1:0,a=bodyAsset(item,r);ctx.save();ctx.shadowColor='#0008';ctx.shadowBlur=Math.max(3,Math.min(w,h)*.1);ctx.shadowOffsetY=Math.max(2,h*.04);ctx.drawImage(a.canvas,x,y,w,h);ctx.restore()}
function drawPowerStow(b,tx,ty,actualW,actualH,side,cell,lx){
 if(conveyorArt.complete&&conveyorArt.naturalWidth&&headArt.complete&&headArt.naturalWidth){
  const artH=actualH*.98,artW=artH*(conveyorArt.naturalWidth/conveyorArt.naturalHeight),split=.285;
  const beltW=Math.max(28,cell*3.02),fixedCx=tx+actualW+side*.47,baseAx=fixedCx-artW*.585;
  const maxY=ty+b.line*cell,headW=beltW*1.24,headH=headW*(headArt.naturalHeight/headArt.naturalWidth);
  const headTop=maxY-headH-5,headBeltY=headTop+headH*.64,joinY=headBeltY+beltW*.10,baseDrawH=ty+actualH-joinY-8;

  // The vehicle and the entire exterior rise stay fixed. The clip prevents its backdrop entering the hold.
  ctx.save();ctx.beginPath();ctx.rect(tx+actualW+2,ty-4,side+artW,actualH+12);ctx.clip();ctx.globalAlpha=.99;
  ctx.drawImage(conveyorArt,0,conveyorArt.naturalHeight*split,conveyorArt.naturalWidth,conveyorArt.naturalHeight*(1-split),baseAx,joinY,artW,baseDrawH);ctx.restore();

  // One key step equals one roller. The fixed end eases into the horizontal retractable section.
  const dx=fixedCx-lx,steps=Math.max(0,Math.round(dx/cell)),rollerCount=Math.max(3,steps+2),controlX=fixedCx-dx*.42;
  const point=q=>{q=clamp(q,0,1);const u=1-q,p0={x:fixedCx,y:joinY},p1={x:fixedCx-beltW*.10,y:joinY-beltW*.16},p2={x:controlX,y:headBeltY},p3={x:lx,y:headBeltY};return{x:u*u*u*p0.x+3*u*u*q*p1.x+3*u*q*q*p2.x+q*q*q*p3.x,y:u*u*u*p0.y+3*u*u*q*p1.y+3*u*q*q*p2.y+q*q*q*p3.y}};

  // Slim steel rails and yellow cables only—no enclosing belt panel or background shape.
  for(const rail of [{off:.48,color:'#b8c2c6',w:5},{off:.56,color:'#f3ca18',w:3}]){ctx.save();ctx.strokeStyle=rail.color;ctx.lineWidth=rail.w;ctx.lineCap='round';for(const sign of [-1,1]){ctx.beginPath();for(let j=0;j<=30;j++){const q=j/30,p=point(q),pa=point(Math.max(0,q-.01)),pb=point(Math.min(1,q+.01)),a=Math.atan2(pb.y-pa.y,pb.x-pa.x)+Math.PI/2,x=p.x+Math.cos(a)*beltW*rail.off*sign,y=p.y+Math.sin(a)*beltW*rail.off*sign;j?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke()}ctx.restore()}

  for(let j=0;j<rollerCount;j++){const q=rollerCount===1?0:j/(rollerCount-1),p=point(q),pa=point(Math.max(0,q-.012)),pb=point(Math.min(1,q+.012)),a=Math.atan2(pb.y-pa.y,pb.x-pa.x)+Math.PI/2,rw=beltW*.39;
   ctx.save();ctx.translate(p.x,p.y);ctx.rotate(a);const g=ctx.createLinearGradient(-rw,0,rw,0);g.addColorStop(0,'#6f7b80');g.addColorStop(.13,'#edf1f2');g.addColorStop(.27,'#30383b');g.addColorStop(.52,'#080b0d');g.addColorStop(.76,'#20272a');g.addColorStop(.9,'#919da2');g.addColorStop(1,'#eef2f3');ctx.strokeStyle=g;ctx.lineWidth=Math.max(6,beltW*.16);ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-rw,0);ctx.lineTo(rw,0);ctx.stroke();ctx.restore()}

  // Bags travel continuously up the fixed rise and across the current roller count.
  const bottom=ty+actualH*.92,pathPoint=t=>{t=clamp(t,0,1);if(t<.66){const q=t/.66;return{x:fixedCx,y:bottom+(joinY-bottom)*q}}return point((t-.66)/.34)};
  for(let i=2;i>=0;i--){const item=b.queue[i],r=i===0?b.rotation:0,z=rotated(item,r),prog=b.belt-i*BELT_GAP;if(prog<0||prog>1)continue;const p=pathPoint(prog),iw=z.w*cell,ih=z.h*cell;drawItem(item,p.x-iw/2,p.y-ih/2,iw,ih,r?Math.PI/2:0)}

  // Only the discharge head/operator moves. Its bottom remains above the maximum-fill line.
  ctx.drawImage(headArt,lx-headW*.50,headTop,headW,headH);
  return
 }
}
function drawMatterPieces(b,tx,ty,cell){const scale=cell/PHYS;for(const body of b.pieces){const info=body.plugin.bag,a=info.asset,o=info.offset,c=Math.cos(body.angle),s=Math.sin(body.angle),ox=o.x*c-o.y*s,oy=o.x*s+o.y*c,cx=tx+(body.position.x-ox)*scale,cy=ty+(body.position.y-oy)*scale,w=a.w*scale,h=a.h*scale;ctx.save();ctx.translate(cx,cy);ctx.rotate(body.angle);ctx.shadowColor='#0009';ctx.shadowBlur=Math.max(3,Math.min(w,h)*.11);ctx.shadowOffsetY=Math.max(2,h*.045);ctx.drawImage(a.canvas,-w/2,-h/2,w,h);ctx.restore();if(debugPhysics){ctx.save();ctx.strokeStyle=info.settled?'#31ff91':'#ffe45b';ctx.lineWidth=2;ctx.beginPath();body.vertices.forEach((v,i)=>{const x=tx+v.x*scale,y=ty+v.y*scale;i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.closePath();ctx.stroke();ctx.fillStyle='#ff3b62';ctx.beginPath();ctx.arc(tx+body.position.x*scale,ty+body.position.y*scale,3,0,7);ctx.fill();ctx.restore()}}}
function drawBoard(b,index,total){const gap=total===2?10:0,slotW=W/total,bx=index*slotW+gap,usableW=slotW-gap*2,top=H*.09,bottom=H*.94,tubeH=bottom-top,side=Math.max(total===2?82:125,usableW*(total===2?.23:.19)),tubeW=usableW-side-18,x=bx+8,y=top,cell=Math.min(tubeW/b.cols,tubeH/b.rows),actualW=cell*b.cols,actualH=cell*b.rows,tx=x+(tubeW-actualW)/2,ty=y+(tubeH-actualH)/2;
 ctx.fillStyle=b.flash?'#71818a':'#4d5b62';ctx.strokeStyle='#98a7ad';ctx.lineWidth=5;ctx.save();ctx.shadowColor='#000b';ctx.shadowBlur=24;ctx.shadowOffsetY=10;tubePath(tx,ty,actualW,actualH);ctx.restore();ctx.save();ctx.beginPath();ctx.roundRect(tx,ty,actualW,actualH,Math.min(actualW*.18,70));ctx.clip();const floor=ctx.createLinearGradient(tx,ty,tx+actualW,ty);floor.addColorStop(0,'#26353d');floor.addColorStop(.18,'#69777d');floor.addColorStop(.5,'#3d4c53');floor.addColorStop(.82,'#718086');floor.addColorStop(1,'#26353d');ctx.globalAlpha=.55;ctx.fillStyle=floor;ctx.fillRect(tx,ty,actualW,actualH);ctx.globalAlpha=1;drawMatterPieces(b,tx,ty,cell);ctx.restore();
 ctx.strokeStyle='#ff4c55';ctx.lineWidth=4;ctx.setLineDash([13,8]);ctx.beginPath();ctx.moveTo(tx,ty+b.line*cell);ctx.lineTo(tx+actualW,ty+b.line*cell);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#ffdadc';ctx.font='900 12px Arial';ctx.textAlign='left';ctx.fillText('MAX FILL',tx+7,ty+b.line*cell-7);
 const nz=rotated(b.queue[0],b.rotation),lx=tx+b.loaderX*cell+nz.w*cell/2;drawPowerStow(b,tx,ty,actualW,actualH,side,cell,lx);ctx.fillStyle='#fff';ctx.font='900 16px Arial';ctx.textAlign='left';ctx.fillText(b.id+' · '+b.score+' PTS · '+b.count+' BAGS'+(b.bonusCount?' +5 BONUS = '+(b.count+b.bonusCount)+' TOTAL':'')+' · SPEED '+(1+b.count*.015).toFixed(1)+'×',tx,ty-14);if(b.bonusFlash>0){ctx.save();ctx.globalAlpha=Math.min(1,b.bonusFlash*2);ctx.fillStyle=b.bonusColor||'#ffcf4c';ctx.strokeStyle='#071117';ctx.lineWidth=6;ctx.font='900 '+Math.max(18,Math.min(30,actualW*.055))+'px Arial';ctx.textAlign='center';ctx.strokeText('COLOR BRIDGE! +5 BAGS',tx+actualW/2,ty+actualH*.18);ctx.fillText('COLOR BRIDGE! +5 BAGS',tx+actualW/2,ty+actualH*.18);ctx.restore()}if(b.gameOver){ctx.fillStyle='#071117cc';ctx.fillRect(tx,ty,actualW,actualH);ctx.fillStyle='#ffcf4c';ctx.font='900 30px Arial';ctx.textAlign='center';ctx.fillText('HOLD FULL',tx+actualW/2,ty+actualH/2)}}
function render(){ctx.clearRect(0,0,W,H);const grad=ctx.createLinearGradient(0,0,0,H);grad.addColorStop(0,'#172832');grad.addColorStop(1,'#071117');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);ctx.fillStyle='#d8e2e5';ctx.globalAlpha=.12;ctx.beginPath();ctx.ellipse(W*.5,H*.5,W*.62,H*.72,0,0,7);ctx.fill();ctx.globalAlpha=1;boards.forEach((b,i)=>drawBoard(b,i,boards.length))}
function loop(t){const dt=Math.min(.04,(t-last)/1000||0);last=t;update(dt);render();requestAnimationFrame(loop)}requestAnimationFrame(loop);
function keys(e,on){if(!running)return;const k=e.key.toLowerCase();if(k==='b'&&on){debugPhysics=!debugPhysics;hud.innerHTML='<b>COLLISION VIEW '+(debugPhysics?'ON':'OFF')+'</b> · B toggles';e.preventDefault();return}let b,action;if(k==='a'){b=boards[0];action='left'}if(k==='d'){b=boards[0];action='right'}if(k==='w'){b=boards[0];action='rotate'}if(k==='s'){b=boards[0];action='fast'}if(k==='arrowleft'){b=versus?boards[1]:boards[0];action='left'}if(k==='arrowright'){b=versus?boards[1]:boards[0];action='right'}if(k==='arrowup'){b=versus?boards[1]:boards[0];action='rotate'}if(k==='arrowdown'){b=versus?boards[1]:boards[0];action='fast'}if(!b||b.gameOver)return;e.preventDefault();if(action==='fast'){b.fast=on;return}if(on){if(action==='left')moveLoader(b,-1);if(action==='right')moveLoader(b,1);if(action==='rotate')rotateLoader(b)}}addEventListener('keydown',e=>keys(e,true));addEventListener('keyup',e=>keys(e,false));
document.querySelectorAll('[data-bag]').forEach(btn=>{const a=btn.dataset.bag;btn.addEventListener('pointerdown',e=>{e.preventDefault();const b=boards[0];if(!b)return;if(a==='fast'){b.fast=true;btn.classList.add('active');btn.setPointerCapture(e.pointerId);return}if(a==='left')moveLoader(b,-1);if(a==='right')moveLoader(b,1);if(a==='rotate')rotateLoader(b)});['pointerup','pointercancel','lostpointercapture'].forEach(ev=>btn.addEventListener(ev,()=>{if(boards[0])boards[0].fast=false;btn.classList.remove('active')}))});
async function start(v){audio=new(window.AudioContext||window.webkitAudioContext)();document.querySelector('#game').classList.add('hiddenGame');wrap.hidden=false;uiIntro(false);running=false;hud.innerHTML='<b>PREPARING FINAL BAG PHYSICS…</b>';await assetsReady;bodyCache.clear();reset(v)}
function uiIntro(show){document.querySelector('#intro').classList.toggle('hide',!show)}
document.querySelector('#startBagSolo').onclick=()=>start(false);document.querySelector('#startBagVersus').onclick=()=>start(true);document.querySelector('#bagPause').onclick=e=>{paused=!paused;e.currentTarget.textContent=paused?'RESUME':'PAUSE'};document.querySelector('#bagRestart').onclick=()=>reset(versus);document.querySelector('#bagMenu').onclick=()=>{running=false;paused=false;wrap.hidden=true;document.querySelector('#game').classList.remove('hiddenGame');uiIntro(true)};
})();

</script>
