';
let docMarkup='';
const host=document.querySelector('#docHost'),frame=document.querySelector('#docFrame'),intro=document.querySelector('#intro');
document.querySelector('#startDocs').addEventListener('click',()=>{if(!docMarkup){const raw=atob(DOCUMENT_CONTROL_HTML),bytes=Uint8Array.from(raw,ch=>ch.charCodeAt(0));docMarkup=new TextDecoder().decode(bytes)}intro.classList.add('hide');host.hidden=false;frame.srcdoc=docMarkup});
document.querySelector('#docMenu').addEventListener('click',()=>{frame.srcdoc='';host.hidden=true;intro.classList.remove('hide')});
})();
</script>
<script>
(()=>{'use strict';
const TERMINAL_ASSIST_HTML='';
let assistMarkup='';
const assistHost=document.querySelector('#assistHost'),assistFrame=document.querySelector('#assistFrame'),assistFrame2=document.querySelector('#assistFrame2'),assistChallenge=document.querySelector('#assistChallenge');
function getAssistMarkup(){if(!assistMarkup){const raw=atob(TERMINAL_ASSIST_HTML),bytes=Uint8Array.from(raw,ch=>ch.charCodeAt(0));assistMarkup=new TextDecoder().decode(bytes)}return assistMarkup}
function roleMarkup(role){return getAssistMarkup().replace("const CONTROL_ROLE='solo';","const CONTROL_ROLE='"+role+"';")}
function openAssist(split){document.querySelector('#intro').classList.add('hide');assistHost.hidden=false;assistHost.classList.toggle('assistSplit',split);assistChallenge.hidden=!split;assistFrame2.hidden=!split;assistFrame.srcdoc=roleMarkup(split?'p1':'solo');if(split)assistFrame2.srcdoc=roleMarkup('p2');else assistFrame2.srcdoc=''}
document.querySelector('#startAssist').addEventListener('click',()=>openAssist(false));
document.querySelector('#startAssistVersus').addEventListener('click',()=>openAssist(true));
document.querySelector('#assistMenu').addEventListener('click',()=>{assistHost.hidden=true;assistHost.classList.remove('assistSplit');assistChallenge.hidden=true;assistFrame.srcdoc='';assistFrame2.srcdoc='';assistFrame2.hidden=true;document.querySelector('#intro').classList.remove('hide')});
})();
</script>
<script>
/* Airport Frenzy expansion: unified menu/audio controls + Air Marshalling */
(()=>{
'use strict';
document.title='Airport Frenzy — Six Airport Games';
const intro=document.querySelector('#intro');
const grid=intro.querySelector('.arcadeGrid');
const hint=intro.querySelector('.desktopHint');
if(hint)hint.textContent='Airport Frenzy · six offline games · keyboard and touch support';

/* Document Control now exposes both modes from the main menu. */
const oldDocs=document.querySelector('#startDocs');
if(oldDocs){
  const modes=oldDocs.closest('.startModes');
  oldDocs.hidden=true;
  modes.insertAdjacentHTML('beforeend','<button class="start" id="startDocsSolo">SOLO PLAY</button><button class="start versus" id="startDocsPass">PASS &amp; PLAY</button>');
  const launchDocMode=mode=>{
    const frame=document.querySelector('#docFrame');
    let chosen=false;
    const choose=()=>{
      if(chosen)return;
      try{
        const d=frame.contentDocument;
        const target=d&&d.querySelector(mode==='solo'?'#singleBtn':'#versusBtn');
        if(target){chosen=true;target.click();}
      }catch(_e){}
      if(!chosen)setTimeout(choose,80);
    };
    oldDocs.click();
    setTimeout(choose,80);
  };
  document.querySelector('#startDocsSolo').onclick=()=>launchDocMode('solo');
  document.querySelector('#startDocsPass').onclick=()=>launchDocMode('pass');
}

/* Soft, generated airport-lounge music. It stays offline and starts after a user gesture. */
let musicCtx=null,musicGain=null,musicTimer=null,musicStep=0,musicMuted=false;
const lounge=[261.63,329.63,392,493.88,440,349.23,293.66,392];
function tone(freq,dur=.13,vol=.035,type='sine'){
  if(!musicCtx)return;
  const o=musicCtx.createOscillator(),g=musicCtx.createGain(),now=musicCtx.currentTime;
  o.type=type;o.frequency.value=freq;g.gain.setValueAtTime(0,now);g.gain.linearRampToValueAtTime(vol,now+.018);g.gain.exponentialRampToValueAtTime(.0001,now+dur);
  o.connect(g).connect(musicCtx.destination);o.start(now);o.stop(now+dur+.03);
}
function musicTick(){
  if(!musicCtx||musicMuted)return;
  const f=lounge[musicStep++%lounge.length];
  tone(f,.7,.008,'sine');tone(f/2,1.15,.004,'triangle');
}
function startMusic(){
  if(musicCtx){musicCtx.resume();return;}
  musicCtx=new (window.AudioContext||window.webkitAudioContext)();
  musicGain=musicCtx.createGain();musicGain.gain.value=.16;musicGain.connect(musicCtx.destination);
  musicTick();musicTimer=setInterval(musicTick,820);
}
addEventListener('pointerdown',startMusic,{once:true});addEventListener('keydown',startMusic,{once:true});
const soundButton=document.createElement('button');
soundButton.id='soundToggle';soundButton.textContent='♪ MUSIC';soundButton.setAttribute('aria-label','Toggle background music');
soundButton.onclick=()=>{startMusic();musicMuted=!musicMuted;soundButton.textContent=musicMuted?'♪ MUTED':'♪ MUSIC';if(!musicMuted)musicTick();};
document.body.append(soundButton);
document.addEventListener('click',e=>{if(e.target.closest('button')&&!window.__afUiSfxMuted){startMusic();tone(620,.065,.018,'triangle');}},true);

/* Common navigation controls for every embedded game. */
function installHostTools(hostId,frameId,menuId,relaunchId){
  const host=document.querySelector(hostId),frame=document.querySelector(frameId),menu=document.querySelector(menuId);
  if(!host||!frame||!menu)return;
  menu.textContent='← MAIN MENU';
  const bar=document.createElement('div');bar.className='universalTools';
  bar.innerHTML='<button class="uPause">PAUSE</button><button class="uMode">MODE SELECT</button>';
  menu.after(bar);
  let visualPause=false;
  bar.querySelector('.uPause').onclick=e=>{
    let handled=false,lastLabel='PAUSE';
    host.querySelectorAll('iframe:not([hidden])').forEach(f=>{try{const p=f.contentDocument&&f.contentDocument.querySelector('#pause');if(p){p.click();handled=true;lastLabel=p.textContent;}}catch(_e){}});
    if(handled)e.currentTarget.textContent=lastLabel;
    else{visualPause=!visualPause;host.querySelectorAll('iframe').forEach(f=>f.style.visibility=visualPause?'hidden':'visible');e.currentTarget.textContent=visualPause?'RESUME':'PAUSE';}
  };
  bar.querySelector('.uMode').onclick=()=>{menu.click();setTimeout(()=>document.querySelector(relaunchId)?.click(),60);};
  host.querySelectorAll('iframe').forEach(f=>f.addEventListener('load',()=>{try{f.contentDocument.addEventListener('click',ev=>{if(ev.target.closest('button'))tone(520,.055,.014,'triangle')},true)}catch(_e){}}));
}
installHostTools('#cabinHost','#cabinFrame','#cabinMenu','#startCabin');
installHostTools('#assistHost','#assistFrame','#assistMenu','#startAssist');
installHostTools('#docHost','#docFrame','#docMenu','#startDocs');

/* Ramp Runner and Bag Stacker already pause natively; add both explicit exits. */
const rampButtons=document.querySelector('.topButtons');
if(rampButtons){const b=document.createElement('button');b.id='rampMain';b.textContent='MAIN MENU';b.onclick=()=>{const p=document.querySelector('#pause'),m=document.querySelector('#modeSelect');if(m.hidden)p.click();setTimeout(()=>m.click(),20)};rampButtons.append(b)}
const bagButtons=document.querySelector('.bagButtons');
if(bagButtons){const b=document.createElement('button');b.textContent='MODE SELECT';b.onclick=()=>document.querySelector('#bagMenu').click();bagButtons.insertBefore(b,document.querySelector('#bagMenu'))}

const AIR_MARSHALLING_HTML=`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><title>Air Marshalling</title><style>
.armStatus{position:absolute;z-index:16;left:50%;bottom:max(74px,calc(env(safe-area-inset-bottom) + 64px));transform:translateX(-50%);display:flex;gap:7px;pointer-events:none}.armCheck{min-width:118px;padding:8px 10px;border:2px solid #ffffff55;border-radius:999px;background:#082133d9;text-align:center;font-size:11px;font-weight:1000;letter-spacing:.04em;box-shadow:0 6px 18px #0018}.armCheck.ready{color:#102b38;background:#71ff9b;border-color:#d9ffe5;box-shadow:0 0 18px #71ff9baa}@media(max-width:430px){.armStatus{bottom:max(71px,calc(env(safe-area-inset-bottom) + 61px));gap:4px}.armCheck{min-width:103px;padding:7px 6px;font-size:10px}}
.person{bottom:10%!important}.armStatus{top:43%;bottom:auto;width:min(94vw,580px);justify-content:center}.armCheck{flex:1;max-width:280px;min-width:0;border-color:#8bdfff70;background:#071f30e8;color:#fff;line-height:1.2}.armCheck.ready{background:#071f30e8;color:#fff;border-color:#8bdfff70;box-shadow:0 6px 18px #0018}.submit{left:50%!important;right:auto!important;bottom:max(5px,env(safe-area-inset-bottom))!important;transform:translateX(-50%);min-width:84px!important;min-height:40px!important;padding:9px 13px!important;border-radius:12px!important;font-size:12px!important;box-shadow:0 4px 0 #a66f05!important}.submit:active{transform:translate(-50%,3px)!important}@media(max-width:430px){.person{bottom:11%!important}.armStatus{top:45%;width:96vw}.armCheck{font-size:9px;padding:6px 5px}.status{bottom:max(52px,calc(env(safe-area-inset-bottom) + 48px))!important}}@media(orientation:landscape) and (max-height:520px){.person{bottom:7%!important}.armStatus{left:67%;top:8%;width:56vw}.submit{left:67%!important}}
.trainer{right:3%!important;bottom:1%!important;width:250px!important;height:330px!important;transform:scale(.34)!important;transform-origin:bottom right!important}.demoing .trainer{animation:trainerBob .42s infinite alternate!important}@keyframes trainerBob{from{transform:scale(.34) translateY(0)}to{transform:scale(.34) translateY(-9px)}}
:root{--navy:#0b2638;--yellow:#ffd34e;--orange:#ff742d;--sky:#70cef4;--green:#62e28d}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:Inter,system-ui,Arial,sans-serif;color:white;background:#68c6ef;touch-action:none}.game{height:100dvh;position:relative;overflow:hidden;background:linear-gradient(#54bce9 0 42%,#b9d2d1 42% 46%,#414b51 46% 100%)}.cloud{position:absolute;background:#fff9;border-radius:99px;filter:blur(.2px)}.c1{width:150px;height:34px;left:4%;top:14%}.c2{width:100px;height:25px;right:8%;top:10%}.runway{position:absolute;inset:46% 0 0;background:linear-gradient(100deg,#424b51,#252e34);clip-path:polygon(28% 0,72% 0,100% 100%,0 100%)}.runway:after{content:'';position:absolute;left:49%;top:0;width:2.5%;height:100%;background:repeating-linear-gradient(#fff 0 42px,transparent 42px 82px)}.grass{position:absolute;top:44%;height:9%;left:0;right:0;background:repeating-linear-gradient(90deg,#7eaf5c 0 25px,#75a653 25px 50px);opacity:.9}.hud{position:absolute;z-index:20;left:10px;right:10px;top:max(8px,env(safe-area-inset-top));display:flex;align-items:center;gap:7px}.brand{font-weight:1000;letter-spacing:.07em;color:var(--yellow);text-shadow:0 2px 3px #0008;margin-right:auto}.pill,.hud button{border:1px solid #ffffff42;background:#082133dc;color:white;border-radius:11px;padding:8px 10px;font-weight:900}.hud button{cursor:pointer}.monitor{position:absolute;z-index:5;left:50%;top:7%;transform:translateX(-50%);width:min(82vw,620px);height:min(31vh,230px);border:7px solid #15384a;border-radius:24px;background:linear-gradient(#72d1f5 0 55%,#556168 55%);box-shadow:0 14px 30px #0018,inset 0 0 0 3px #d6f5ff;overflow:hidden}.monitor:before{content:'LIVE RAMP TRAINER';position:absolute;z-index:6;left:12px;top:9px;font-size:11px;font-weight:1000;letter-spacing:.13em;background:#102c3ccb;padding:5px 8px;border-radius:7px}.plane{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);width:46%;height:32%;filter:drop-shadow(0 8px 7px #0006);transition:transform .45s}.plane .body{position:absolute;left:38%;top:0;width:24%;height:100%;background:linear-gradient(90deg,#b9c8ce,#fff 48%,#9faeb4);border-radius:55% 55% 40% 40%}.plane .wing{position:absolute;left:4%;right:4%;top:45%;height:23%;background:linear-gradient(#eaf3f5,#9badb4);clip-path:polygon(0 78%,42% 0,58% 0,100% 78%,98% 100%,58% 72%,42% 72%,2% 100%)}.trainer{position:absolute;right:6%;bottom:3%;width:82px;height:104px;transform-origin:50% 76%;transition:transform .3s}.person{position:absolute;z-index:6;left:50%;bottom:4%;width:250px;height:330px;transform:translateX(-50%);filter:drop-shadow(0 10px 7px #0007)}.head{position:absolute;left:91px;top:7px;width:69px;height:77px;border-radius:47%;background:#935e43;border:5px solid #172c38}.cap{position:absolute;left:82px;top:0;width:87px;height:30px;border-radius:40px 40px 8px 8px;background:#14364a;border-bottom:8px solid #ff9c2f}.phones{position:absolute;left:76px;top:22px;width:99px;height:45px;border:7px solid #152d3a;border-bottom:0;border-radius:48px 48px 0 0}.phones:after,.phones:before{content:'';position:absolute;top:18px;width:16px;height:34px;background:#ff8a27;border:4px solid #122a38;border-radius:7px}.phones:before{left:-12px}.phones:after{right:-12px}.torso{position:absolute;left:70px;top:76px;width:110px;height:155px;background:#152f43;border-radius:25px 25px 15px 15px;border:5px solid #0a1d2a}.vest{position:absolute;inset:8px 7px;background:linear-gradient(90deg,#ff6c25 0 24%,#fff596 24% 35%,#ff742d 35% 65%,#fff596 65% 76%,#ff6c25 76%);clip-path:polygon(0 0,35% 0,50% 33%,65% 0,100% 0,91% 100%,9% 100%)}.legs{position:absolute;left:82px;top:218px;width:86px;height:105px;border-left:27px solid #182f43;border-right:27px solid #182f43}.arm{position:absolute;top:91px;width:116px;height:24px;transform-origin:12px 12px;transition:transform .14s ease}.arm.left{left:78px}.arm.right{left:156px}.arm .limb{position:absolute;left:0;top:5px;width:78px;height:15px;background:#8f5b43;border:4px solid #142d3c;border-radius:15px}.wand{position:absolute;left:70px;top:7px;width:59px;height:10px;border-radius:9px;background:#ff7b26;box-shadow:0 0 8px 3px #ff9e44,0 0 17px #ff5b22;border:2px solid #ffe3a5}.arm.right .wand{transform-origin:left}.dragHandle{position:absolute;z-index:15;width:54px;height:54px;border-radius:50%;border:3px solid #fff;background:#ff742dcf;box-shadow:0 0 15px #ff8a3e;display:grid;place-items:center;font-weight:1000;touch-action:none}.dragHandle:after{content:'WAND';font-size:8px}.prompt{position:absolute;z-index:12;left:50%;top:38%;transform:translateX(-50%);width:min(90vw,650px);text-align:center;background:#09293be5;border:2px solid #ffffff38;border-radius:16px;padding:9px 12px;box-shadow:0 8px 22px #0018}.prompt strong{display:block;color:var(--yellow);font-size:clamp(16px,3vw,24px)}.prompt small{display:block;opacity:.8;margin-top:3px}.status{position:absolute;z-index:12;left:10px;bottom:max(10px,env(safe-area-inset-bottom));display:flex;gap:7px;align-items:center}.submit{position:absolute;z-index:15;right:12px;bottom:max(12px,env(safe-area-inset-bottom));border:0;border-radius:18px;padding:16px 20px;background:linear-gradient(#ffe473,#ffc62f);color:#132b3a;font-weight:1000;font-size:16px;box-shadow:0 7px 0 #a66f05;touch-action:manipulation}.submit:active{transform:translateY(4px);box-shadow:0 3px 0 #a66f05}.overlay{position:fixed;z-index:50;inset:0;background:#061d2be9;display:grid;place-items:center;padding:18px}.overlay.hidden{display:none}.card{width:min(94vw,650px);max-height:94vh;overflow:auto;background:linear-gradient(145deg,#153f56,#092434);border:2px solid #7ddcff;border-radius:24px;padding:22px;text-align:center;box-shadow:0 30px 80px #000}.card h1{margin:0;color:var(--yellow);font-size:clamp(28px,7vw,50px)}.card p{line-height:1.45;color:#d4effa}.card button{width:100%;min-height:54px;margin-top:10px;border:0;border-radius:14px;background:var(--yellow);font-weight:1000;color:#102c3c;font-size:17px}.legend{display:grid;grid-template-columns:1fr 1fr;gap:6px;text-align:left;font-size:11px;margin:12px 0}.legend span{background:#ffffff0d;border-radius:8px;padding:6px}.demoing .trainer{animation:bob .42s infinite alternate}.circle .right{animation:circleArm .75s linear infinite}.flash{animation:flash .25s}@keyframes bob{to{transform:translateY(-3px)}}@keyframes circleArm{to{transform:rotate(360deg)!important}}@keyframes flash{50%{filter:brightness(1.7)}}@media(max-height:680px){.monitor{height:25vh}.person{transform:translateX(-50%) scale(.75);transform-origin:bottom}.prompt{top:31%}}@media(max-width:560px){.monitor{width:94vw;height:25vh;top:8%}.person{width:220px;height:300px;transform:translateX(-50%) scale(.87);transform-origin:bottom}.prompt{top:32%;padding:7px}.status{font-size:11px}.pill{padding:6px}.hud .brand{font-size:12px}.hud button{font-size:10px;padding:7px}.submit{padding:13px 15px}.dragHandle{width:48px;height:48px}}
</style><style>@media (pointer:coarse),(max-width:760px){.hud{left:6px;right:6px;gap:4px;flex-wrap:wrap}.hud .brand{flex:1 1 100%;font-size:11px}.pill,.hud button{padding:6px 7px;font-size:10px;background:#082133bd;backdrop-filter:blur(7px)}.monitor{top:13%;height:23vh}.prompt{top:35%;width:94vw}.dragHandle{width:58px;height:58px;background:#d95822c9;border-color:#fff;backdrop-filter:blur(5px)}.submit{min-width:112px;min-height:56px;background:#ffd34ee8}.status{max-width:58%;flex-wrap:wrap}}@media (max-width:430px){.hud #mode{display:none}.monitor{top:15%}.prompt{top:37%;font-size:11px}.person{transform:translateX(-50%) scale(.78)}}@media (orientation:landscape) and (max-height:520px){.hud .brand{flex:0 1 auto}.monitor{left:25%;top:13%;width:44vw;height:29vh}.prompt{left:25%;top:43%;width:47vw}.person{left:67%;transform:translateX(-50%) scale(.7)}.status{bottom:6px}.submit{bottom:8px}}</style></head><body><main class="game" id="game"><div class="cloud c1"></div><div class="cloud c2"></div><div class="grass"></div><div class="runway"></div><header class="hud"><div class="brand">AIR MARSHALLING</div><div class="pill" id="round">ROUND 1</div><div class="pill" id="best">BEST 0</div><button id="pause">PAUSE</button><button id="mode">MODE SELECT</button><button id="mainMenu">MAIN MENU</button></header><section class="monitor" id="monitor"><div class="plane"><i class="wing"></i><i class="body"></i></div><div class="trainer" id="trainer"></div></section><div class="prompt" id="prompt"><strong>WATCH THE RAMP TRAINER</strong><small>The next sequence will begin here.</small></div><div class="person" id="person"><div class="legs"></div><div class="torso"><i class="vest"></i></div><div class="head"></div><div class="cap"></div><div class="phones"></div><div class="arm left" id="leftArm"><i class="limb"></i><i class="wand"></i></div><div class="arm right" id="rightArm"><i class="limb"></i><i class="wand"></i></div></div><div class="dragHandle" id="leftHandle"></div><div class="dragHandle" id="rightHandle"></div><div class="status"><div class="pill" id="step">WATCH</div><div class="pill" id="message">Training standard</div></div><button class="submit" id="submit">SIGNAL ✦</button></main><section class="overlay" id="start"><div class="card"><h1>AIR MARSHALLING</h1><p>Watch the ramp trainer, then repeat the growing signal sequence. Drag each glowing wand like a puppet on mobile, or pose both arms with the keyboard.</p><div class="legend"><span><b>Left arm</b><br>W up · S down · A out · D inner · Q forward</span><span><b>Right arm</b><br>↑ up · ↓ down · → out · ← inner · Enter forward</span><span><b>Submit</b><br>Space or SIGNAL</span><span><b>Circular motion</b><br>Draw a loop with the indicated wand or press /</span></div><p><small>Training-game interpretation of standardized ramp signals. Always follow your airport’s approved training and procedures.</small></p><button id="begin">BEGIN TRAINING</button></div></section><section class="overlay hidden" id="over"><div class="card"><h1 id="overTitle">SEQUENCE LOST</h1><p id="summary"></p><button id="again">TRY AGAIN</button><button id="select">MODE SELECT</button><button id="overMain">MAIN MENU</button></div></section><script>
(()=>{'use strict';
const $=s=>document.querySelector(s),game=$('#game'),person=$('#person'),trainer=$('#trainer'),monitor=$('#monitor'),prompt=$('#prompt'),message=$('#message'),step=$('#step'),roundEl=$('#round'),bestEl=$('#best');
const commands=[
 {id:'forward',name:'PROCEED FORWARD',l:'inner',r:'inner',note:'Both wands beckon the aircraft forward.'},
 {id:'left',name:'TURN LEFT',l:'out',r:'inner',note:'Left arm indicates direction; opposite arm guides the turn.'},
 {id:'right',name:'TURN RIGHT',l:'inner',r:'out',note:'Right arm indicates direction; opposite arm guides the turn.'},
 {id:'stop',name:'NORMAL STOP',l:'up',r:'up',note:'Raise both wands and cross above the head.'},
 {id:'estop',name:'EMERGENCY STOP',l:'up',r:'up',taps:2,note:'Rapid overhead cross — press SIGNAL twice.'},
 {id:'slow',name:'SLOW DOWN',l:'down',r:'down',note:'Both wands low with a controlled downward signal.'},
 {id:'startengine',name:'START ENGINE',l:'down',r:'up',circle:'r',note:'Right wand circles overhead; left indicates the engine.'},
 {id:'cutengine',name:'CUT ENGINE',l:'down',r:'inner',note:'Right wand moves across the throat; left remains low.'},
 {id:'setbrakes',name:'SET BRAKES',l:'front',r:'front',taps:2,note:'Both wands forward; double SIGNAL represents closing fists.'},
 {id:'releasebrakes',name:'RELEASE BRAKES',l:'front',r:'front',note:'Both wands forward; one SIGNAL represents opening hands.'}
];
const poses={out:{l:-165,r:-15},inner:{l:-25,r:-155},up:{l:-58,r:-122},down:{l:75,r:105},front:{l:-52,r:-128}};
let sequence=[],playerIndex=0,round=1,running=false,paused=false,demoing=false,expected=null,tapCount=0,tapTimer=0,circleReady={l:false,r:false},best=+(localStorage.airMarshallBest||0),audio=null;
bestEl.textContent='BEST '+best;
function sfx(kind){audio||(audio=new (window.AudioContext||window.webkitAudioContext)());const o=audio.createOscillator(),g=audio.createGain(),n=audio.currentTime;o.type=kind==='bad'?'sawtooth':'triangle';o.frequency.setValueAtTime(kind==='bad'?130:kind==='good'?760:440,n);if(kind==='good')o.frequency.exponentialRampToValueAtTime(1080,n+.14);g.gain.setValueAtTime(.055,n);g.gain.exponentialRampToValueAtTime(.0001,n+.22);o.connect(g).connect(audio.destination);o.start();o.stop(n+.24)}
function workerMarkup(){return '<div class="legs"></div><div class="torso"><i class="vest"></i></div><div class="head"></div><div class="cap"></div><div class="phones"></div><div class="arm left"><i class="limb"></i><i class="wand"></i></div><div class="arm right"><i class="limb"></i><i class="wand"></i></div>'}trainer.innerHTML=workerMarkup();
const arms={l:$('#leftArm'),r:$('#rightArm')},handles={l:$('#leftHandle'),r:$('#rightHandle')},zones={l:'down',r:'down'},shoulders={},lastReady={l:false,r:false};
const armStatus=document.createElement('div');armStatus.className='armStatus';armStatus.innerHTML='<span class="armCheck" id="leftCheck">LEFT · LOW</span><span class="armCheck" id="rightCheck">RIGHT · LOW</span>';game.append(armStatus);const armChecks={l:$('#leftCheck'),r:$('#rightCheck')},zoneNames={up:'UP',down:'LOW',out:'OUT',inner:'IN',front:'FORWARD'};
function armFeedback(side){const possibilities={l:{up:'STOP · EMERGENCY STOP',down:'SLOW · START ENGINE · CUT ENGINE',out:'TURN LEFT',inner:'FORWARD · TURN RIGHT',front:'SET BRAKES · RELEASE BRAKES'},r:{up:'STOP · EMERGENCY STOP · START ENGINE',down:'SLOW',out:'TURN RIGHT',inner:'FORWARD · TURN LEFT · CUT ENGINE',front:'SET BRAKES · RELEASE BRAKES'}};armChecks[side].textContent=(side==='l'?'LEFT':'RIGHT')+' — '+possibilities[side][zones[side]];armChecks[side].classList.remove('ready')}
function setPose(side,zone,target='player'){const root=target==='trainer'?trainer:person,arm=root.querySelector('.arm.'+(side==='l'?'left':'right')),deg=poses[zone][side];arm.style.transform='rotate('+deg+'deg)';if(target==='player'){zones[side]=zone;placeHandle(side,deg);armFeedback(side)}}
function placeHandle(side,deg){const p=person.getBoundingClientRect(),x=p.left+(side==='l'?90:168),y=p.top+104,rad=deg*Math.PI/180,len=112;handles[side].style.left=(x+Math.cos(rad)*len-27)+'px';handles[side].style.top=(y+Math.sin(rad)*len-27)+'px'}
function resetPose(){lastReady.l=lastReady.r=false;setPose('l','down');setPose('r','down');circleReady={l:false,r:false};tapCount=0}
function showCommand(c){expected=c;prompt.innerHTML='<strong>'+c.name+'</strong><small>'+c.note+' &nbsp;·&nbsp; '+keyPrompt(c)+'</small>';setPose('l',c.l,'trainer');setPose('r',c.r,'trainer');monitor.classList.toggle('circle',!!c.circle);monitor.classList.add('demoing');sfx('cue')}
function keyPrompt(c){const mapL={up:'W',down:'S',out:'A',inner:'D',front:'Q'},mapR={up:'↑',down:'↓',out:'→',inner:'←',front:'ENTER'};return 'Keys: 